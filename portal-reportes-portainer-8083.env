# Zona horaria
TZ=America/Caracas

# Portal público: http://IP_DEL_SERVIDOR:8083
PORTAL_BIND=0.0.0.0
PORTAL_HTTP_PORT=8083
FRONTEND_ORIGIN=*

# PostgreSQL interno
POSTGRES_DB=portal_reportes
POSTGRES_USER=portal_reportes
POSTGRES_PASSWORD=CAMBIAR_POR_CLAVE_POSTGRES_LARGA

# PocketBase
PB_VERSION=0.39.10
PB_SUPERUSER_EMAIL=infraestructura@ejemplo.com
PB_SUPERUSER_PASSWORD=CAMBIAR_POR_CLAVE_SUPERUSUARIO_LARGA
PB_ENCRYPTION_KEY=CAMBIAR_POR_CADENA_ALEATORIA_DE_32_CARACTERES
PB_GOMEMLIMIT=512MiB

# El panel de PocketBase solo queda accesible desde el propio servidor.
# Para administrarlo remotamente use un túnel SSH o cambie temporalmente a 0.0.0.0.
POCKETBASE_BIND=127.0.0.1
POCKETBASE_PORT=8090

# Usuario inicial para ingresar al Portal de Reportes
PORTAL_ADMIN_NAME=Administrador
PORTAL_ADMIN_EMAIL=admin@ejemplo.com
PORTAL_ADMIN_PASSWORD=CAMBIAR_POR_CLAVE_DE_8_O_MAS_CARACTERES

# SmartOLT
SMARTOLT_BASE_URL=https://cablenorte.smartolt.com/
SMARTOLT_STATUS_PATH=api/onu/get_onus_statuses
SMARTOLT_DETAILS_PATH=
SMARTOLT_SIGNALS_PATH=api/onu/get_onus_signals
SMARTOLT_OLTS_PATH=
SMARTOLT_API_TOKEN=CAMBIAR_POR_TOKEN_REAL
SMARTOLT_AUTH_HEADER=X-Token
SMARTOLT_AUTH_SCHEME=
SMARTOLT_TIMEOUT_MS=90000

# Ajustes de reportes
DEFAULT_WINDOW_MONTHS=12
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=120000
DB_QUERY_TIMEOUT_MS=120000
OPERACIONES_ORDENES_SCHEMA=powerbi
OPERACIONES_ORDENES_TABLE=ordenes_servicio
