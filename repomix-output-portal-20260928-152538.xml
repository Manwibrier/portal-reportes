  font-size: 0.63rem;
  font-weight: 600;
  line-height: 1.15;
  text-align: center;
  letter-spacing: 0.01em;
  text-shadow: none !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* 4. Nortico mas grande y sin sombra/borde/caja */
.sidebar__mascot-image,
.sidebar__mascot,
.portal-sidebar-nortico-image {
  position: relative;
  z-index: 1;
  display: block;
  width: 148px !important;
  max-width: 148px !important;
  height: auto !important;
  margin: 0 auto !important;
  object-fit: contain;
  object-position: center bottom;
  background: transparent !important;
  background-image: none !important;
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  filter: none !important;
  text-shadow: none !important;
  transform: none !important;
  transition: none !important;
  user-select: none;
}

/* 5. Evitar que el hover vuelva a poner sombra */
.sidebar__mascot-panel:hover .sidebar__mascot-image,
.sidebar__mascot-panel:hover .sidebar__mascot,
.sidebar__mascot-panel:hover .portal-sidebar-nortico-image,
.sidebar__mascot-image:hover,
.sidebar__mascot:hover,
.portal-sidebar-nortico-image:hover {
  transform: none !important;
  filter: none !important;
  box-shadow: none !important;
}

/* 6. Si hay wrappers internos con fondo/borde, limpiarlos */
.sidebar__mascot-wrap,
.sidebar__mascot-container,
.sidebar__brand-footer,
.sidebar__footer {
  background: transparent !important;
  background-image: none !important;
  border: 0 !important;
  box-shadow: none !important;
  outline: 0 !important;
}

/* 7. Ajuste para pantallas mas pequenas */
@media (max-width: 900px) {
  .sidebar__mascot-image,
  .sidebar__mascot,
  .portal-sidebar-nortico-image {
