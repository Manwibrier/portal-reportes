  display: grid;
  min-height: 220px;
  place-items: center;
  color: var(--text-secondary);
  font-size: 0.74rem;
}

/* TECNICOS */

.operaciones-os-tech-kpis {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
