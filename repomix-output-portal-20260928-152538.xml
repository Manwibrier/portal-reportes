/* OPERACIONES_OS_MENU_R2_BEGIN */

.operaciones-os-standard-page {
  display: flex;
  flex-direction: column;
  gap: var(--portal-grid-gap-lg);
}

/* MENU TIPO COBRANZA - TABLAS */

.operaciones-os-tab-menu {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 0;
  padding: 6px;
  overflow: hidden;
}

.operaciones-os-tab-menu__button {
  position: relative;
  min-height: 42px;
  padding: 8px 10px;
  border: 0;
  border-right: 1px solid rgba(0, 61, 145, 0.13);
  background: transparent;
  color: var(--norte-blue-deep);
  font: inherit;
  font-size: 0.71rem;
  line-height: 1.15;
  font-weight: 650;
  cursor: pointer;
}

.operaciones-os-tab-menu__button:last-child {
  border-right: 0;
}

.operaciones-os-tab-menu__button::after {
  position: absolute;
  right: 12px;
  bottom: 5px;
  left: 12px;
  height: 2px;
  border-radius: 999px;
  background: transparent;
  content: "";
}

.operaciones-os-tab-menu__button:hover {
  background: rgba(0, 61, 145, 0.055);
}

.operaciones-os-tab-menu__button:hover::after {
  background: #ff5c00;
}

/* FLECHA FLOTANTE - SIN CIRCULO */

.operaciones-os-floating-top {
  position: fixed;
  right: 25px;
  bottom: 25px;
  z-index: 99999;

  width: auto;
  height: auto;
  padding: 2px 8px 7px;

  border: 0 !important;
  outline: 0;
  background: transparent !important;

  color: #ff5c00;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 3.25rem;
  line-height: 0.8;
  font-weight: 900;

  cursor: pointer;

  text-shadow:
    -1.4px -1.4px 0 #003d91,
     1.4px -1.4px 0 #003d91,
    -1.4px  1.4px 0 #003d91,
     1.4px  1.4px 0 #003d91,
     0 7px 9px rgba(15, 23, 42, 0.24);

  transition:
    transform 0.16s ease,
    filter 0.16s ease;
}

.operaciones-os-floating-top:hover {
  transform:
    translateY(-5px)
    scale(1.08);

  filter:
    drop-shadow(
      0 5px 4px
      rgba(15, 23, 42, 0.22)
    );
}

.operaciones-os-floating-top:active {
  transform:
    translateY(-1px)
    scale(0.97);
}

/* BLOQUES */

.operaciones-os-dashboard-block {
  display: flex;
  flex-direction: column;
  gap: var(--portal-grid-gap);
  scroll-margin-top: 80px;
}

.operaciones-os-dashboard-block
+
.operaciones-os-dashboard-block {
  margin-top: 12px;
  padding-top: 20px;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

.operaciones-os-type-heading {
  min-height: 30px;
}

.operaciones-os-type-heading h2 {
  margin: 0;
  color: var(--norte-blue-deep);
  font-size: 1.05rem;
  line-height: 1.15;
  font-weight: 750;
}

/* KPIs */

.operaciones-os-period-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--portal-grid-gap);
}

.operaciones-os-period-card {
  overflow: hidden;
}

.operaciones-os-period-card__header {
  padding: 9px 13px;
  border-bottom: 1px solid var(--portal-card-border);
  color: var(--norte-blue-deep);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
}

.operaciones-os-period-card--previous {
  border-top: 4px solid #ff5c00;
}

.operaciones-os-period-card--previous
.operaciones-os-period-card__header {
  color: #d94f00;
}

.operaciones-os-primary-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin: 10px 11px;
  padding: 10px 13px;

  border-radius: 9px;
  background: #f8fbff;
}

.operaciones-os-primary-total span {
  color: var(--norte-blue-ink);
