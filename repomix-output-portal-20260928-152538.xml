/* 3. Designed by debajo del robot, en 2 lineas */
.sidebar__mascot-panel::after {
  content: "Designed by\A An\00e1lisis de Datos" !important;
  display: block !important;
  white-space: pre-line;
  margin-top: 2px;
  color: rgba(255, 255, 255, 0.86);
