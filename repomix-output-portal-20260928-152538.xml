          barSize={18}
        >
          <CartesianGrid {...gridProps} />

          <XAxis
            {...xAxisProps}
            type="number"
            tickFormatter={(value) =>
              metric?.format === 'percent'
                ? `${Number(value).toFixed(0)}%`
                : formatValue(value)
            }
          />

          <YAxis
            {...yAxisProps}
            type="category"
            dataKey="departamento"
            width={210}
            tickMargin={8}
            tickFormatter={(value) => truncateLabel(String(value), 30)}
          />

          {tooltip}

          <Bar
            dataKey="cantidad"
            radius={[0, 9, 9, 0]}
            fill={resolvedBarColor}
          >
            {data.map((_, index) => (
              <Cell
                key={`department-cell-${index}`}
                fill={resolvedBarColor}
              />
            ))}

            <LabelList
