<file path="Querys/Cobranza - 24-08-2026">
let
    ConsultaSQL =
        Text.Combine(
            {
                "WITH parametros AS (",
                "    SELECT",
                "        TIMESTAMP '2026-08-01 00:00:00' AS mes_desde,",
                "        TIMESTAMP '2026-09-01 00:00:00' AS mes_hasta,",
                "        TIMESTAMP '2026-08-01 01:01:00' AS fin_carga_masiva,",
                "        DATE '2026-08-01' AS fecha_tarifa,",
                "        748.7864::numeric(12,4) AS tasa_cargo",
                "),",
                "",
                "-- Cargos con movimientos válidos durante julio",
                "movimientos_julio_ids AS MATERIALIZED (",
                "    SELECT DISTINCT",
                "        rf.id_cargo_cliente",
                "    FROM administrativo.d_renglon_factura rf",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "-- Una fila por franquicia para evitar multiplicar cargos",
                "zonas_franquicia AS MATERIALIZED (",
                "    SELECT",
                "        fz.id_franquicia,",
                "        count(DISTINCT fz.id_zona)::integer AS cantidad_zonas,",
                "        string_agg(",
                "            DISTINCT z.zona,",
                "            ' | '",
                "            ORDER BY z.zona",
                "        ) AS zona",
                "    FROM operativo.m_franquicia_zona fz",
                "    JOIN ubigeo.m_zona z",
                "      ON z.id_zona = fz.id_zona",
                "    WHERE fz.fecha_eliminacion IS NULL",
                "      AND z.fecha_eliminacion IS NULL",
                "    GROUP BY",
                "        fz.id_franquicia",
                "),",
                "",
                "-- Clasificación principal: una fila por cargo",
                "cargos_clasificados AS MATERIALIZED (",
                "    SELECT",
                "        dcc.id_cargo_cliente,",
                "        dcc.id_cliente,",
                "        dcc.id_contrato_detalle,",
                "        cd.id_contrato,",
                "        dcc.id_paquete,",
                "        dcc.id_estatus,",
                "        dcc.fecha_creacion AS fecha_cargo,",
                "        cd.fecha_corte,",
                "        cd.id_franquicia,",
                "        cd.id_sector,",
                "        ctr.numero_contrato,",
                "        cli.rif,",
                "        cli.razon_social,",
                "        srv.servicio,",
                "        est.estatus AS estatus_cliente,",
                "        fr.nombre_franquicia,",
                "        zf.zona,",
                "        coalesce(zf.cantidad_zonas, 0) AS cantidad_zonas,",
                "",
                "        CASE",
                "            WHEN dcc.fecha_creacion < p.mes_desde",
                "             AND mj.id_cargo_cliente IS NOT NULL",
                "                THEN 'RECUPERADO'",
                "",
                "            WHEN dcc.fecha_creacion >= p.mes_desde",
                "             AND dcc.fecha_creacion < p.fin_carga_masiva",
                "                THEN 'GENERADO'",
                "",
                "            WHEN dcc.fecha_creacion >= p.fin_carga_masiva",
                "             AND dcc.fecha_creacion < p.mes_hasta",
                "                THEN 'POSTERIOR'",
                "        END AS tipo_cargo,",
                "",
                "        CASE",
                "            WHEN dcc.id_estatus = 58",
                "             AND mj.id_cargo_cliente IS NOT NULL",
                "                THEN 'PAGADO'",
                "            ELSE 'NO PAGADO'",
                "        END AS estado_pago",
                "",
                "    FROM administrativo.d_cargo_cliente dcc",
                "    JOIN operativo.m_contrato_detalle cd",
                "      ON cd.id_contrato_detalle = dcc.id_contrato_detalle",
                "    LEFT JOIN operativo.m_contrato ctr",
                "      ON ctr.id_contrato = cd.id_contrato",
                "    LEFT JOIN operativo.m_cliente cli",
                "      ON cli.id_cliente = dcc.id_cliente",
                "    LEFT JOIN operativo.m_franquicia fr",
                "      ON fr.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN zonas_franquicia zf",
                "      ON zf.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN operativo.m_tipo_servicio ts",
                "      ON ts.id_tipo_servicio = cd.id_tipo_servicio",
                "    LEFT JOIN operativo.m_servicio srv",
                "      ON srv.id_servicio = ts.id_servicio",
                "    LEFT JOIN comun.m_estatus est",
                "      ON est.id_estatus = cd.id_estatus",
                "    LEFT JOIN movimientos_julio_ids mj",
                "      ON mj.id_cargo_cliente = dcc.id_cargo_cliente",
                "    CROSS JOIN parametros p",
                "    WHERE dcc.fecha_creacion >= TIMESTAMP '2026-01-01 00:00:00'",
                "      AND dcc.fecha_creacion < p.mes_hasta",
                "      AND dcc.id_tipo_renglon in (1,9) ",
                "),",
                "",
                "cargos_scope AS MATERIALIZED (",
                "    SELECT",
                "        cc.*",
                "    FROM cargos_clasificados cc",
                "    WHERE cc.tipo_cargo IS NOT NULL",
                "),",
                "",
                "-- Renglones vinculados a movimientos de julio",
                "renglones_julio AS MATERIALIZED (",
                "    SELECT",
                "        rf.id_renglon_factura,",
                "        rf.id_cargo_cliente,",
                "        rf.id_factura,",
                "        rf.id_tarifa_servicio,",
                "        rf.id_moneda,",
                "        rf.id_ajuste_estatico,",
                "        rf.total_bruto::numeric AS total_bruto,",
                "        mf.fecha_registro AS fecha_movimiento",
                "    FROM cargos_scope cs",
                "    JOIN administrativo.d_renglon_factura rf",
                "      ON rf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "-- Prioriza la tarifa realmente utilizada en la factura",
                "tarifa_facturada AS MATERIALIZED (",
                "    SELECT DISTINCT ON (rj.id_cargo_cliente)",
                "        rj.id_cargo_cliente,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro::numeric AS monto_cobro",
                "    FROM renglones_julio rj",
                "    JOIN operativo.m_tarifa_servicio tas",
                "      ON tas.id_tarifa_servicio = rj.id_tarifa_servicio",
                "    WHERE rj.id_ajuste_estatico IS NULL",
                "      AND rj.id_tarifa_servicio IS NOT NULL",
                "    ORDER BY",
                "        rj.id_cargo_cliente,",
                "        rj.fecha_movimiento DESC,",
                "        rj.id_renglon_factura DESC",
                "),",
                "",
                "tarifas_julio AS MATERIALIZED (",
                "    SELECT",
                "        tas.id_tarifa_servicio,",
                "        tas.id_paquete,",
                "        tas.id_franquicia,",
                "        tas.id_sector,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro::numeric AS monto_cobro",
                "    FROM operativo.m_tarifa_servicio tas",
                "    CROSS JOIN parametros p",
                "    WHERE tas.fecha_vigencia = p.fecha_tarifa",
                "      AND tas.activo = true",
                "      AND tas.fecha_eliminacion IS NULL",
                "),",
                "",
                "-- Tarifa configurada para cargos sin factura",
                "tarifa_configurada AS (",
                "    SELECT DISTINCT ON (cs.id_cargo_cliente)",
                "        cs.id_cargo_cliente,",
                "        tj.id_moneda_cobro,",
                "        tj.monto_cobro",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf",
                "      ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN tarifas_julio tj",
                "      ON tj.id_paquete = cs.id_paquete",
                "     AND tj.id_franquicia = cs.id_franquicia",
                "     AND (",
                "            tj.id_sector = cs.id_sector",
                "            OR (",
                "                cs.id_sector IS DISTINCT FROM 11362",
                "                AND tj.id_sector IS DISTINCT FROM 11362",
                "            )",
                "         )",
                "    WHERE tf.id_cargo_cliente IS NULL",
                "      AND cs.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "    ORDER BY",
                "        cs.id_cargo_cliente,",
                "        CASE",
                "            WHEN tj.id_sector IS NOT DISTINCT FROM cs.id_sector",
                "                THEN 1",
                "            WHEN tj.id_sector IS NULL",
                "                THEN 2",
                "            ELSE 3",
                "        END,",
                "        tj.id_tarifa_servicio DESC",
                "),",
                "",
                "claves_tasa AS (",
                "    SELECT DISTINCT",
                "        rj.id_moneda,",
                "        rj.fecha_movimiento::date AS fecha_tasa",
                "    FROM renglones_julio rj",
                "    WHERE rj.id_moneda IS NOT NULL",
                "),",
                "",
                "-- Una llamada a la función por moneda y fecha",
                "tasas_movimiento AS (",
                "    SELECT",
                "        ct.id_moneda,",
                "        ct.fecha_tasa,",
                "        tx.tasa",
                "    FROM claves_tasa ct",
                "    LEFT JOIN LATERAL (",
                "        SELECT",
                "            tm.tasa::numeric AS tasa",
                "        FROM administrativo.tasa_moneda_read(",
                "            ct.id_moneda,",
                "            51,",
                "            ct.fecha_tasa",
                "        ) tm(",
                "            id_d_tasa_moneda,",
                "            id_moneda,",
                "            tasa,",
                "            fecha_tasa,",
                "            fecha_eliminacion,",
                "            id_moneda_base",
                "        )",
                "        LIMIT 1",
                "    ) tx",
                "      ON true",
                "),",
                "",
                "movimientos_por_cargo AS (",
                "    SELECT",
                "        rj.id_cargo_cliente,",
                "",
                "        max(rj.fecha_movimiento) FILTER (",
                "            WHERE rj.id_ajuste_estatico IS NULL",
                "        ) AS fecha_pago,",
                "",
                "        max(rj.fecha_movimiento) FILTER (",
                "            WHERE rj.id_ajuste_estatico > 0",
                "        ) AS fecha_descuento,",
                "",
                "        count(DISTINCT rj.id_factura)::integer",
                "            AS cantidad_facturas,",
                "",
                "        coalesce(",
                "            sum(rj.total_bruto) FILTER (",
                "                WHERE rj.id_ajuste_estatico IS NULL",
                "            ),",
                "            0",
                "        ) AS monto_pago_bs,",
                "",
                "        coalesce(",
                "            sum(",
                "                rj.total_bruto / nullif(tm.tasa, 0)",
                "            ) FILTER (",
                "                WHERE rj.id_ajuste_estatico IS NULL",
                "            ),",
                "            0",
                "        ) AS monto_pago_usd,",
                "",
                "        abs(",
                "            coalesce(",
                "                sum(rj.total_bruto) FILTER (",
                "                    WHERE rj.id_ajuste_estatico > 0",
                "                ),",
                "                0",
                "            )",
                "        ) AS monto_descuento_bs,",
                "",
                "        abs(",
                "            coalesce(",
                "                sum(",
                "                    rj.total_bruto / nullif(tm.tasa, 0)",
                "                ) FILTER (",
                "                    WHERE rj.id_ajuste_estatico > 0",
                "                ),",
                "                0",
                "            )",
                "        ) AS monto_descuento_usd,",
                "",
                "        count(*) FILTER (",
                "            WHERE tm.tasa IS NULL",
                "        )::integer AS renglones_sin_tasa",
                "",
                "    FROM renglones_julio rj",
                "    LEFT JOIN tasas_movimiento tm",
                "      ON tm.id_moneda = rj.id_moneda",
                "     AND tm.fecha_tasa = rj.fecha_movimiento::date",
                "    GROUP BY",
                "        rj.id_cargo_cliente",
                "),",
                "",
                "detalle AS (",
                "    SELECT",
                "        cs.*,",
                "        coalesce(",
                "            tf.id_moneda_cobro,",
                "            tc.id_moneda_cobro,",
                "            0",
                "        )::integer AS id_moneda_cargo,",
                "",
                "        coalesce(",
                "            tf.monto_cobro,",
                "            tc.monto_cobro,",
                "            0",
                "        )::numeric AS monto_cargo_bs,",
                "",
                "        mp.fecha_pago,",
                "        mp.fecha_descuento,",
                "        coalesce(mp.cantidad_facturas, 0) AS cantidad_facturas,",
                "        coalesce(mp.monto_pago_bs, 0) AS monto_pago_bs,",
                "        coalesce(mp.monto_pago_usd, 0) AS monto_pago_usd,",
                "        coalesce(mp.monto_descuento_bs, 0) AS monto_descuento_bs,",
                "        coalesce(mp.monto_descuento_usd, 0) AS monto_descuento_usd,",
                "        coalesce(mp.renglones_sin_tasa, 0) AS renglones_sin_tasa",
                "",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf",
                "      ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN tarifa_configurada tc",
                "      ON tc.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN movimientos_por_cargo mp",
                "      ON mp.id_cargo_cliente = cs.id_cargo_cliente",
                ")",
                "",
                "SELECT",
                "    d.id_cargo_cliente,",
                "    d.id_cliente,",
                "    d.rif,",
                "    d.razon_social,",
                "    d.id_contrato,",
                "    d.id_contrato_detalle,",
                "    d.numero_contrato,",
                "    d.fecha_cargo,",
                "    d.fecha_corte,",
                "    d.fecha_pago,",
                "    d.fecha_descuento,",
                "    d.tipo_cargo,",
                "    d.estado_pago,",
                "    d.servicio,",
                "    d.estatus_cliente,",
                "    d.id_franquicia,",
                "    d.nombre_franquicia,",
                "    d.zona,",
                "    d.cantidad_zonas,",
                "    d.id_moneda_cargo,",
                "",
                "    p.tasa_cargo::numeric(12,4) AS tasa_cargo,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN round(d.monto_cargo_bs, 2)",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_cargo_bs,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN round(",
                "                d.monto_cargo_bs / nullif(p.tasa_cargo, 0),",
                "                2",
                "            )",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_cargo_usd,",
                "",
                "    round(d.monto_pago_bs, 2)::numeric(18,2)",
                "        AS monto_pago_bs,",
                "",
                "    round(d.monto_pago_usd, 2)::numeric(18,2)",
                "        AS monto_pago_usd,",
                "",
                "    round(d.monto_descuento_bs, 2)::numeric(18,2)",
                "        AS monto_descuento_bs,",
                "",
                "    round(d.monto_descuento_usd, 2)::numeric(18,2)",
                "        AS monto_descuento_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN greatest(",
                "                round(",
                "                    d.monto_cargo_bs / nullif(p.tasa_cargo, 0),",
                "                    2",
                "                )",
                "                - round(d.monto_pago_usd, 2)",
                "                - round(d.monto_descuento_usd, 2),",
                "                0",
                "            )",
                "        ELSE 0",
                "    END::numeric(18,2) AS saldo_pendiente_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo = 'RECUPERADO'",
                "         AND d.estado_pago = 'PAGADO'",
                "            THEN round(d.monto_pago_usd, 2)",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_recuperado_usd,",
                "",
                "    d.cantidad_facturas,",
                "    d.renglones_sin_tasa",
                "",
                "FROM detalle d",
                "CROSS JOIN parametros p;"
            },
            "#(lf)"
        ),
    Origen =
        Odbc.Query(
            "dsn=PostgreSQL64CE",
            ConsultaSQL
        ),
    #"Columnas con nombre cambiado" =
        Table.RenameColumns(
            Origen,
            {
                {"monto_descuento_usd", "descuento_usd"}
            }
        )
in
    #"Columnas con nombre cambiado"
</file>

<file path="Querys/Cobranza MR">
SELECT COUNT(DISTINCT id_contrato_detalle), SUM(monto_bs) monto_bs, SUM(monto_usd) monto_usd from (
	select DISTINCT
		dcc.id_cargo_cliente,
		dcc.id_contrato_detalle,
		--dcc.id_paquete,
		--dcc.id_tipo_renglon,			
		---dcc.concepto,
		max(tas.id_tarifa_servicio) as id_tarifa_servicio,
		--dcc.cantidad cantidad,			
		--um_cargo.id_unidad_medida,
		--case when um_cargo.abreviatura is null then '' else  um_cargo.abreviatura end AS unidad_medida,
		/*(case 		
			when dcc.id_tipo_renglon=1 and um_cargo.id_unidad_medida = 57 then --mes completo
				(tas.monto_cobro*tasa*dcc.cantidad_puntos) 
			when dcc.id_tipo_renglon=1 and um_cargo.id_unidad_medida = 55 then --dias
				CAST((tas.monto_cobro*( dcc.cantidad/comun.read_dias_del_mes(dcc.fecha_registro::date))*tasa*dcc.cantidad_puntos) AS NUMERIC(100,2))
			end
		)
		 as monto,*/
		tas.monto_cobro*tmon.tasa monto_bs,
		tas.monto_cobro*tmon.tasa/ 748.7864 monto_usd,
		mon.id_moneda,
		mon.abreviatura moneda
		--f.nombre_franquicia nombre_franquicia,
		--est.estatus estatus_contrato_detalle,
		--dcc.fecha_registro,
		--dcc.fecha_cobro
	from  cargos_agosto_2026 dcc
	inner join operativo.m_cliente cli on cli.id_cliente = dcc.id_cliente	
	inner join operativo.m_contrato c on c.id_cliente = cli.id_cliente and c.id_contrato = dcc.id_contrato
	inner join operativo.m_contrato_detalle cd on cd.id_contrato_detalle = dcc.id_contrato_detalle
	inner join operativo.franquicia f on cd.id_franquicia = f.id_franquicia
	LEFT join operativo.m_tarifa_servicio tas on tas.fecha_eliminacion is null and 
		tas.id_paquete = dcc.id_paquete and 
		(tas.id_franquicia = f.id_franquicia and (cd.id_sector <> 11362 or cd.id_sector is null) and (tas.id_sector is null or tas.id_sector <>11362 ) or  tas.id_franquicia = f.id_franquicia and tas.id_sector = cd.id_sector) AND 
		activo = true and dcc.id_tipo_renglon in (1,9)
		and extract(month from dcc.fecha_registro::date) = extract( month from tas.fecha_vigencia::date)
		and extract(year from dcc.fecha_registro::date) = extract( year from tas.fecha_vigencia::date)	
	LEFT JOIN administrativo.d_tasa_moneda tmon on tmon.id_d_tasa_moneda = (SELECT id_d_tasa_moneda FROM administrativo.tasa_moneda_read(
		63, 
		tas.id_moneda_cobro, 
		'2026-08-01'
	))
	--LEFT JOIN comun.unidad_medida um_tarifa on um_tarifa.id_unidad_medida = tis.id_unidad_medida
	LEFT JOIN comun.unidad_medida um_cargo on um_cargo.id_unidad_medida = dcc.id_unidad_medida
	LEFT JOIN comun.moneda mon on (mon.id_moneda = tmon.id_moneda_base and tmon.id_moneda_base is not null ) or (mon.id_moneda = 63 and tmon.id_moneda_base is null)
	where  dcc.id_tipo_renglon in(1,9) 
	and dcc.fecha_creacion  = '2026-08-01 00:10:00.005469'
	and f.id_franquicia not in (180)
	group by dcc.id_cargo_cliente, dcc.id_contrato_detalle, tas.monto_cobro, tmon.tasa,mon.id_moneda, mon.abreviatura
)t
</file>

<file path="Querys/Cobranza.txt">
let
    ConsultaSQL =
        Text.Combine(
            {
                "WITH parametros AS (",
                "    SELECT",
                "        TIMESTAMP '2026-08-01 00:00:00' AS mes_desde,",
                "        TIMESTAMP '2026-09-01 00:00:00' AS mes_hasta,",
                "        TIMESTAMP '2026-08-01 01:01:00' AS fin_carga_masiva,",
                "        DATE '2026-08-01' AS fecha_tarifa,",
                "        748.7864::numeric(12,4) AS tasa_cargo",
                "),",
                "",
                "-- Cargos con movimientos válidos durante julio",
                "movimientos_julio_ids AS MATERIALIZED (",
                "    SELECT DISTINCT",
                "        rf.id_cargo_cliente",
                "    FROM administrativo.d_renglon_factura rf",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "-- Una fila por franquicia para evitar multiplicar cargos",
                "zonas_franquicia AS MATERIALIZED (",
                "    SELECT",
                "        fz.id_franquicia,",
                "        count(DISTINCT fz.id_zona)::integer AS cantidad_zonas,",
                "        string_agg(",
                "            DISTINCT z.zona,",
                "            ' | '",
                "            ORDER BY z.zona",
                "        ) AS zona",
                "    FROM operativo.m_franquicia_zona fz",
                "    JOIN ubigeo.m_zona z",
                "      ON z.id_zona = fz.id_zona",
                "    WHERE fz.fecha_eliminacion IS NULL",
                "      AND z.fecha_eliminacion IS NULL",
                "    GROUP BY",
                "        fz.id_franquicia",
                "),",
                "",
                "-- Clasificación principal: una fila por cargo",
                "cargos_clasificados AS MATERIALIZED (",
                "    SELECT",
                "        dcc.id_cargo_cliente,",
                "        dcc.id_cliente,",
                "        dcc.id_contrato_detalle,",
                "        cd.id_contrato,",
                "        dcc.id_paquete,",
                "        dcc.id_estatus,",
                "        dcc.fecha_creacion AS fecha_cargo,",
                "        cd.fecha_corte,",
                "        cd.id_franquicia,",
                "        cd.id_sector,",
                "        ctr.numero_contrato,",
                "        cli.rif,",
                "        cli.razon_social,",
                "        srv.servicio,",
                "        est.estatus AS estatus_cliente,",
                "        fr.nombre_franquicia,",
                "        zf.zona,",
                "        coalesce(zf.cantidad_zonas, 0) AS cantidad_zonas,",
                "",
                "        CASE",
                "            WHEN dcc.fecha_creacion < p.mes_desde",
                "             AND mj.id_cargo_cliente IS NOT NULL",
                "                THEN 'RECUPERADO'",
                "",
                "            WHEN dcc.fecha_creacion >= p.mes_desde",
                "             AND dcc.fecha_creacion < p.fin_carga_masiva",
                "                THEN 'GENERADO'",
                "",
                "            WHEN dcc.fecha_creacion >= p.fin_carga_masiva",
                "             AND dcc.fecha_creacion < p.mes_hasta",
                "                THEN 'POSTERIOR'",
                "        END AS tipo_cargo,",
                "",
                "        CASE",
                "            WHEN dcc.id_estatus = 58",
                "             AND mj.id_cargo_cliente IS NOT NULL",
                "                THEN 'PAGADO'",
                "            ELSE 'NO PAGADO'",
                "        END AS estado_pago",
                "",
                "    FROM administrativo.d_cargo_cliente dcc",
                "    JOIN operativo.m_contrato_detalle cd",
                "      ON cd.id_contrato_detalle = dcc.id_contrato_detalle",
                "    LEFT JOIN operativo.m_contrato ctr",
                "      ON ctr.id_contrato = cd.id_contrato",
                "    LEFT JOIN operativo.m_cliente cli",
                "      ON cli.id_cliente = dcc.id_cliente",
                "    LEFT JOIN operativo.m_franquicia fr",
                "      ON fr.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN zonas_franquicia zf",
                "      ON zf.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN operativo.m_tipo_servicio ts",
                "      ON ts.id_tipo_servicio = cd.id_tipo_servicio",
                "    LEFT JOIN operativo.m_servicio srv",
                "      ON srv.id_servicio = ts.id_servicio",
                "    LEFT JOIN comun.m_estatus est",
                "      ON est.id_estatus = cd.id_estatus",
                "    LEFT JOIN movimientos_julio_ids mj",
                "      ON mj.id_cargo_cliente = dcc.id_cargo_cliente",
                "    CROSS JOIN parametros p",
                "    WHERE dcc.fecha_creacion >= TIMESTAMP '2026-01-01 00:00:00'",
                "      AND dcc.fecha_creacion < p.mes_hasta",
                "      AND dcc.id_tipo_renglon = 1",
                "),",
                "",
                "cargos_scope AS MATERIALIZED (",
                "    SELECT",
                "        cc.*",
                "    FROM cargos_clasificados cc",
                "    WHERE cc.tipo_cargo IS NOT NULL",
                "),",
                "",
                "-- Renglones vinculados a movimientos de julio",
                "renglones_julio AS MATERIALIZED (",
                "    SELECT",
                "        rf.id_renglon_factura,",
                "        rf.id_cargo_cliente,",
                "        rf.id_factura,",
                "        rf.id_tarifa_servicio,",
                "        rf.id_moneda,",
                "        rf.id_ajuste_estatico,",
                "        rf.total_bruto::numeric AS total_bruto,",
                "        mf.fecha_registro AS fecha_movimiento",
                "    FROM cargos_scope cs",
                "    JOIN administrativo.d_renglon_factura rf",
                "      ON rf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "-- Prioriza la tarifa realmente utilizada en la factura",
                "tarifa_facturada AS MATERIALIZED (",
                "    SELECT DISTINCT ON (rj.id_cargo_cliente)",
                "        rj.id_cargo_cliente,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro::numeric AS monto_cobro",
                "    FROM renglones_julio rj",
                "    JOIN operativo.m_tarifa_servicio tas",
                "      ON tas.id_tarifa_servicio = rj.id_tarifa_servicio",
                "    WHERE rj.id_ajuste_estatico IS NULL",
                "      AND rj.id_tarifa_servicio IS NOT NULL",
                "    ORDER BY",
                "        rj.id_cargo_cliente,",
                "        rj.fecha_movimiento DESC,",
                "        rj.id_renglon_factura DESC",
                "),",
                "",
                "tarifas_julio AS MATERIALIZED (",
                "    SELECT",
                "        tas.id_tarifa_servicio,",
                "        tas.id_paquete,",
                "        tas.id_franquicia,",
                "        tas.id_sector,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro::numeric AS monto_cobro",
                "    FROM operativo.m_tarifa_servicio tas",
                "    CROSS JOIN parametros p",
                "    WHERE tas.fecha_vigencia = p.fecha_tarifa",
                "      AND tas.activo = true",
                "      AND tas.fecha_eliminacion IS NULL",
                "),",
                "",
                "-- Tarifa configurada para cargos sin factura",
                "tarifa_configurada AS (",
                "    SELECT DISTINCT ON (cs.id_cargo_cliente)",
                "        cs.id_cargo_cliente,",
                "        tj.id_moneda_cobro,",
                "        tj.monto_cobro",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf",
                "      ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN tarifas_julio tj",
                "      ON tj.id_paquete = cs.id_paquete",
                "     AND tj.id_franquicia = cs.id_franquicia",
                "     AND (",
                "            tj.id_sector = cs.id_sector",
                "            OR (",
                "                cs.id_sector IS DISTINCT FROM 11362",
                "                AND tj.id_sector IS DISTINCT FROM 11362",
                "            )",
                "         )",
                "    WHERE tf.id_cargo_cliente IS NULL",
                "      AND cs.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "    ORDER BY",
                "        cs.id_cargo_cliente,",
                "        CASE",
                "            WHEN tj.id_sector IS NOT DISTINCT FROM cs.id_sector",
                "                THEN 1",
                "            WHEN tj.id_sector IS NULL",
                "                THEN 2",
                "            ELSE 3",
                "        END,",
                "        tj.id_tarifa_servicio DESC",
                "),",
                "",
                "claves_tasa AS (",
                "    SELECT DISTINCT",
                "        rj.id_moneda,",
                "        rj.fecha_movimiento::date AS fecha_tasa",
                "    FROM renglones_julio rj",
                "    WHERE rj.id_moneda IS NOT NULL",
                "),",
                "",
                "-- Una llamada a la función por moneda y fecha",
                "tasas_movimiento AS (",
                "    SELECT",
                "        ct.id_moneda,",
                "        ct.fecha_tasa,",
                "        tx.tasa",
                "    FROM claves_tasa ct",
                "    LEFT JOIN LATERAL (",
                "        SELECT",
                "            tm.tasa::numeric AS tasa",
                "        FROM administrativo.tasa_moneda_read(",
                "            ct.id_moneda,",
                "            51,",
                "            ct.fecha_tasa",
                "        ) tm(",
                "            id_d_tasa_moneda,",
                "            id_moneda,",
                "            tasa,",
                "            fecha_tasa,",
                "            fecha_eliminacion,",
                "            id_moneda_base",
                "        )",
                "        LIMIT 1",
                "    ) tx",
                "      ON true",
                "),",
                "",
                "movimientos_por_cargo AS (",
                "    SELECT",
                "        rj.id_cargo_cliente,",
                "",
                "        max(rj.fecha_movimiento) FILTER (",
                "            WHERE rj.id_ajuste_estatico IS NULL",
                "        ) AS fecha_pago,",
                "",
                "        max(rj.fecha_movimiento) FILTER (",
                "            WHERE rj.id_ajuste_estatico > 0",
                "        ) AS fecha_descuento,",
                "",
                "        count(DISTINCT rj.id_factura)::integer",
                "            AS cantidad_facturas,",
                "",
                "        coalesce(",
                "            sum(rj.total_bruto) FILTER (",
                "                WHERE rj.id_ajuste_estatico IS NULL",
                "            ),",
                "            0",
                "        ) AS monto_pago_bs,",
                "",
                "        coalesce(",
                "            sum(",
                "                rj.total_bruto / nullif(tm.tasa, 0)",
                "            ) FILTER (",
                "                WHERE rj.id_ajuste_estatico IS NULL",
                "            ),",
                "            0",
                "        ) AS monto_pago_usd,",
                "",
                "        abs(",
                "            coalesce(",
                "                sum(rj.total_bruto) FILTER (",
                "                    WHERE rj.id_ajuste_estatico > 0",
                "                ),",
                "                0",
                "            )",
                "        ) AS monto_descuento_bs,",
                "",
                "        abs(",
                "            coalesce(",
                "                sum(",
                "                    rj.total_bruto / nullif(tm.tasa, 0)",
                "                ) FILTER (",
                "                    WHERE rj.id_ajuste_estatico > 0",
                "                ),",
                "                0",
                "            )",
                "        ) AS monto_descuento_usd,",
                "",
                "        count(*) FILTER (",
                "            WHERE tm.tasa IS NULL",
                "        )::integer AS renglones_sin_tasa",
                "",
                "    FROM renglones_julio rj",
                "    LEFT JOIN tasas_movimiento tm",
                "      ON tm.id_moneda = rj.id_moneda",
                "     AND tm.fecha_tasa = rj.fecha_movimiento::date",
                "    GROUP BY",
                "        rj.id_cargo_cliente",
                "),",
                "",
                "detalle AS (",
                "    SELECT",
                "        cs.*,",
                "        coalesce(",
                "            tf.id_moneda_cobro,",
                "            tc.id_moneda_cobro,",
                "            0",
                "        )::integer AS id_moneda_cargo,",
                "",
                "        coalesce(",
                "            tf.monto_cobro,",
                "            tc.monto_cobro,",
                "            0",
                "        )::numeric AS monto_cargo_bs,",
                "",
                "        mp.fecha_pago,",
                "        mp.fecha_descuento,",
                "        coalesce(mp.cantidad_facturas, 0) AS cantidad_facturas,",
                "        coalesce(mp.monto_pago_bs, 0) AS monto_pago_bs,",
                "        coalesce(mp.monto_pago_usd, 0) AS monto_pago_usd,",
                "        coalesce(mp.monto_descuento_bs, 0) AS monto_descuento_bs,",
                "        coalesce(mp.monto_descuento_usd, 0) AS monto_descuento_usd,",
                "        coalesce(mp.renglones_sin_tasa, 0) AS renglones_sin_tasa",
                "",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf",
                "      ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN tarifa_configurada tc",
                "      ON tc.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN movimientos_por_cargo mp",
                "      ON mp.id_cargo_cliente = cs.id_cargo_cliente",
                ")",
                "",
                "SELECT",
                "    d.id_cargo_cliente,",
                "    d.id_cliente,",
                "    d.rif,",
                "    d.razon_social,",
                "    d.id_contrato,",
                "    d.id_contrato_detalle,",
                "    d.numero_contrato,",
                "    d.fecha_cargo,",
                "    d.fecha_corte,",
                "    d.fecha_pago,",
                "    d.fecha_descuento,",
                "    d.tipo_cargo,",
                "    d.estado_pago,",
                "    d.servicio,",
                "    d.estatus_cliente,",
                "    d.id_franquicia,",
                "    d.nombre_franquicia,",
                "    d.zona,",
                "    d.cantidad_zonas,",
                "    d.id_moneda_cargo,",
                "",
                "    p.tasa_cargo::numeric(12,4) AS tasa_cargo,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN round(d.monto_cargo_bs, 2)",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_cargo_bs,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN round(",
                "                d.monto_cargo_bs / nullif(p.tasa_cargo, 0),",
                "                2",
                "            )",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_cargo_usd,",
                "",
                "    round(d.monto_pago_bs, 2)::numeric(18,2)",
                "        AS monto_pago_bs,",
                "",
                "    round(d.monto_pago_usd, 2)::numeric(18,2)",
                "        AS monto_pago_usd,",
                "",
                "    round(d.monto_descuento_bs, 2)::numeric(18,2)",
                "        AS monto_descuento_bs,",
                "",
                "    round(d.monto_descuento_usd, 2)::numeric(18,2)",
                "        AS monto_descuento_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN greatest(",
                "                round(",
                "                    d.monto_cargo_bs / nullif(p.tasa_cargo, 0),",
                "                    2",
                "                )",
                "                - round(d.monto_pago_usd, 2)",
                "                - round(d.monto_descuento_usd, 2),",
                "                0",
                "            )",
                "        ELSE 0",
                "    END::numeric(18,2) AS saldo_pendiente_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo = 'RECUPERADO'",
                "         AND d.estado_pago = 'PAGADO'",
                "            THEN round(d.monto_pago_usd, 2)",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_recuperado_usd,",
                "",
                "    d.cantidad_facturas,",
                "    d.renglones_sin_tasa",
                "",
                "FROM detalle d",
                "CROSS JOIN parametros p;"
            },
            "#(lf)"
        ),
    Origen =
        Odbc.Query(
            "dsn=PostgreSQL64CE",
            ConsultaSQL
        ),
    #"Columnas con nombre cambiado" =
        Table.RenameColumns(
            Origen,
            {
                {"monto_descuento_usd", "descuento_usd"}
            }
        )
in
    #"Columnas con nombre cambiado"
</file>

<file path="Querys/FactCobranzaDetalle.txt">
let
    ConsultaSQL =
        Text.Combine(
            {
                "WITH parametros AS (",
                "    SELECT",
                "        TIMESTAMP '2026-08-01 00:00:00' AS mes_desde,",
                "        TIMESTAMP '2026-09-01 00:00:00' AS mes_hasta,",
                "        TIMESTAMP '2026-08-01 01:01:00' AS fin_carga_masiva,",
                "        DATE '2026-08-01' AS fecha_tarifa,",
                "        748.7864::numeric(12,4) AS tasa_cargo",
                "),",
                "",
                "movimientos_julio_ids AS MATERIALIZED (",
                "    SELECT DISTINCT",
                "        rf.id_cargo_cliente",
                "    FROM administrativo.d_renglon_factura rf",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "zonas_franquicia AS MATERIALIZED (",
                "    SELECT",
                "        fz.id_franquicia,",
                "        count(DISTINCT fz.id_zona)::integer AS cantidad_zonas,",
                "        string_agg(DISTINCT z.zona, ' | ' ORDER BY z.zona) AS zona",
                "    FROM operativo.m_franquicia_zona fz",
                "    JOIN ubigeo.m_zona z ON z.id_zona = fz.id_zona",
                "    WHERE fz.fecha_eliminacion IS NULL AND z.fecha_eliminacion IS NULL",
                "    GROUP BY fz.id_franquicia",
                "),",
                "",
                "cargos_clasificados AS MATERIALIZED (",
                "    SELECT",
                "        dcc.id_cargo_cliente,",
                "        dcc.id_cliente,",
                "        dcc.id_contrato_detalle,",
                "        cd.id_contrato,",
                "        dcc.id_paquete,",
                "        dcc.id_estatus,",
                "        dcc.fecha_creacion AS fecha_cargo,",
                "        dcc.fecha_registro,",
                "        coalesce(dcc.cantidad_puntos, 1) AS cantidad_puntos,", // Recupera los puntos extra del Excel
                "        cd.fecha_corte,",
                "        cd.id_franquicia,",
                "        cd.id_sector,",
                "        ctr.numero_contrato,",
                "        cli.rif,",
                "        cli.razon_social,",
                "        srv.servicio,",
                "        est.estatus AS estatus_cliente,",
                "        fr.nombre_franquicia,",
                "        zf.zona,",
                "        coalesce(zf.cantidad_zonas, 0) AS cantidad_zonas,",
                "        CASE",
                "            WHEN dcc.fecha_creacion < p.mes_desde AND mj.id_cargo_cliente IS NOT NULL THEN 'RECUPERADO'",
                "            WHEN dcc.fecha_creacion >= p.mes_desde AND dcc.fecha_creacion < p.fin_carga_masiva THEN 'GENERADO'",
                "            WHEN dcc.fecha_creacion >= p.fin_carga_masiva AND dcc.fecha_creacion < p.mes_hasta THEN 'POSTERIOR'",
                "        END AS tipo_cargo,",
                "        CASE",
                "            WHEN dcc.id_estatus = 58 AND mj.id_cargo_cliente IS NOT NULL THEN 'PAGADO'",
                "            ELSE 'NO PAGADO'",
                "        END AS estado_pago",
                "    FROM administrativo.d_cargo_cliente dcc",
                "    JOIN operativo.m_contrato_detalle cd ON cd.id_contrato_detalle = dcc.id_contrato_detalle",
                "    LEFT JOIN operativo.m_contrato ctr ON ctr.id_contrato = cd.id_contrato",
                "    LEFT JOIN operativo.m_cliente cli ON cli.id_cliente = dcc.id_cliente",
                "    LEFT JOIN operativo.m_franquicia fr ON fr.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN zonas_franquicia zf ON zf.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN operativo.m_tipo_servicio ts ON ts.id_tipo_servicio = cd.id_tipo_servicio",
                "    LEFT JOIN operativo.m_servicio srv ON srv.id_servicio = ts.id_servicio",
                "    LEFT JOIN comun.m_estatus est ON est.id_estatus = cd.id_estatus",
                "    LEFT JOIN movimientos_julio_ids mj ON mj.id_cargo_cliente = dcc.id_cargo_cliente",
                "    CROSS JOIN parametros p",
                "    WHERE dcc.fecha_creacion >= TIMESTAMP '2026-01-01 00:00:00'",
                "      AND dcc.fecha_creacion < p.mes_hasta",
                "      AND dcc.id_tipo_renglon in (1,9)",
                "),",
                "",
                "cargos_scope AS MATERIALIZED (",
                "    SELECT cc.* FROM cargos_clasificados cc WHERE cc.tipo_cargo IS NOT NULL",
                "),",
                "",
                "renglones_julio AS MATERIALIZED (",
                "    SELECT",
                "        rf.id_renglon_factura,",
                "        rf.id_cargo_cliente,",
                "        rf.id_factura,",
                "        rf.id_tarifa_servicio,",
                "        rf.id_moneda,",
                "        rf.id_ajuste_estatico,",
                "        rf.total_bruto::numeric AS total_bruto,",
                "        mf.fecha_registro AS fecha_movimiento",
                "    FROM cargos_scope cs",
                "    JOIN administrativo.d_renglon_factura rf ON rf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN administrativo.m_factura mf ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde AND mf.fecha_registro < p.mes_hasta AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "tasas_tarifa AS MATERIALIZED (",
                "    SELECT DISTINCT",
                "        m.id_moneda_cobro,",
                "        (SELECT tm.tasa::numeric FROM administrativo.tasa_moneda_read(63, m.id_moneda_cobro, p.fecha_tarifa) tm LIMIT 1) AS tasa",
                "    FROM (SELECT DISTINCT id_moneda_cobro FROM operativo.m_tarifa_servicio WHERE id_moneda_cobro IS NOT NULL) m",
                "    CROSS JOIN parametros p",
                "),",
                "",
                "tarifas_catalogo AS MATERIALIZED (",
                "    SELECT",
                "        tas.id_tarifa_servicio,",
                "        tas.id_paquete,",
                "        tas.id_franquicia,",
                "        tas.id_sector,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro,",
                "        tas.fecha_vigencia,",
                "        tt.tasa",
                "    FROM operativo.m_tarifa_servicio tas",
                "    CROSS JOIN parametros p",
                "    LEFT JOIN tasas_tarifa tt ON tt.id_moneda_cobro = tas.id_moneda_cobro",
                "    WHERE tas.fecha_eliminacion IS NULL AND tas.activo = true",
                "),",
                "",
                "claves_tasa AS (",
                "    SELECT DISTINCT rj.id_moneda, rj.fecha_movimiento::date AS fecha_tasa",
                "    FROM renglones_julio rj WHERE rj.id_moneda IS NOT NULL",
                "),",
                "",
                "tasas_movimiento AS (",
                "    SELECT ct.id_moneda, ct.fecha_tasa, tx.tasa",
                "    FROM claves_tasa ct",
                "    LEFT JOIN LATERAL (",
                "        SELECT tm.tasa::numeric AS tasa FROM administrativo.tasa_moneda_read(ct.id_moneda, 51, ct.fecha_tasa) tm LIMIT 1",
                "    ) tx ON true",
                "),",
                "",
                "movimientos_por_cargo AS (",
                "    SELECT",
                "        rj.id_cargo_cliente,",
                "        max(rj.fecha_movimiento) FILTER (WHERE rj.id_ajuste_estatico IS NULL) AS fecha_pago,",
                "        max(rj.fecha_movimiento) FILTER (WHERE rj.id_ajuste_estatico > 0) AS fecha_descuento,",
                "        count(DISTINCT rj.id_factura)::integer AS cantidad_facturas,",
                "        coalesce(sum(rj.total_bruto) FILTER (WHERE rj.id_ajuste_estatico IS NULL), 0) AS monto_pago_bs,",
                "        coalesce(sum(rj.total_bruto / nullif(tm.tasa, 0)) FILTER (WHERE rj.id_ajuste_estatico IS NULL), 0) AS monto_pago_usd,",
                "        abs(coalesce(sum(rj.total_bruto) FILTER (WHERE rj.id_ajuste_estatico > 0), 0)) AS monto_descuento_bs,",
                "        abs(coalesce(sum(rj.total_bruto / nullif(tm.tasa, 0)) FILTER (WHERE rj.id_ajuste_estatico > 0), 0)) AS monto_descuento_usd,",
                "        count(*) FILTER (WHERE tm.tasa IS NULL)::integer AS renglones_sin_tasa",
                "    FROM renglones_julio rj",
                "    LEFT JOIN tasas_movimiento tm ON tm.id_moneda = rj.id_moneda AND tm.fecha_tasa = rj.fecha_movimiento::date",
                "    GROUP BY rj.id_cargo_cliente",
                "),",
                "",
                "-- BASE REAL (Tarifa unitaria facturada)",
                "tarifa_facturada AS MATERIALIZED (",
                "    SELECT DISTINCT ON (rj.id_cargo_cliente)",
                "        rj.id_cargo_cliente,",
                "        tas.id_moneda_cobro,",
                "        (tas.monto_cobro::numeric * coalesce(tt.tasa, 1)) AS monto_cobro_unitario_bs",
                "    FROM renglones_julio rj",
                "    JOIN operativo.m_tarifa_servicio tas ON tas.id_tarifa_servicio = rj.id_tarifa_servicio",
                "    LEFT JOIN tasas_tarifa tt ON tt.id_moneda_cobro = tas.id_moneda_cobro",
                "    WHERE rj.id_ajuste_estatico IS NULL AND rj.id_tarifa_servicio IS NOT NULL",
                "    ORDER BY rj.id_cargo_cliente, rj.fecha_movimiento DESC, rj.id_renglon_factura DESC",
                "),",
                "",
                "-- BASE TEÓRICA (Tarifa unitaria del catálogo)",
                "tarifa_configurada AS MATERIALIZED (",
                "    SELECT DISTINCT ON (cs.id_cargo_cliente)",
                "        cs.id_cargo_cliente,",
                "        tc.id_moneda_cobro,",
                "        (tc.monto_cobro::numeric * coalesce(tc.tasa, 1)) AS monto_cobro_unitario_bs",
                "    FROM cargos_scope cs",
                "    JOIN tarifas_catalogo tc",
                "      ON tc.id_paquete = cs.id_paquete",
                "     AND (",
                "            (tc.id_franquicia = cs.id_franquicia AND (cs.id_sector <> 11362 OR cs.id_sector IS NULL) AND (tc.id_sector IS NULL OR tc.id_sector <> 11362))",
                "            OR",
                "            (tc.id_franquicia = cs.id_franquicia AND tc.id_sector = cs.id_sector)",
                "         )",
                "     AND extract(month from cs.fecha_registro::date) = extract(month from tc.fecha_vigencia::date)",
                "     AND extract(year from cs.fecha_registro::date) = extract(year from tc.fecha_vigencia::date)",
                "    WHERE cs.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "    ORDER BY cs.id_cargo_cliente, tc.id_tarifa_servicio DESC",
                "),",
                "",
                "detalle AS (",
                "    SELECT",
                "        cs.*,",
                "        coalesce(tc.id_moneda_cobro, tf.id_moneda_cobro, 0)::integer AS id_moneda_cargo,",
                "        -- Multiplica la tarifa base por la cantidad_puntos para igualar el Excel",
                "        (coalesce(tc.monto_cobro_unitario_bs, tf.monto_cobro_unitario_bs, 0)::numeric * cs.cantidad_puntos) AS monto_cargo_teorico_bs,",
                "        (coalesce(tf.monto_cobro_unitario_bs, tc.monto_cobro_unitario_bs, 0)::numeric * cs.cantidad_puntos) AS monto_cargo_real_bs,",
                "        mp.fecha_pago,",
                "        mp.fecha_descuento,",
                "        coalesce(mp.cantidad_facturas, 0) AS cantidad_facturas,",
                "        coalesce(mp.monto_pago_bs, 0) AS monto_pago_bs,",
                "        coalesce(mp.monto_pago_usd, 0) AS monto_pago_usd,",
                "        coalesce(mp.monto_descuento_bs, 0) AS monto_descuento_bs,",
                "        coalesce(mp.monto_descuento_usd, 0) AS monto_descuento_usd,",
                "        coalesce(mp.renglones_sin_tasa, 0) AS renglones_sin_tasa",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN tarifa_configurada tc ON tc.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN movimientos_por_cargo mp ON mp.id_cargo_cliente = cs.id_cargo_cliente",
                ")",
                "",
                "SELECT",
                "    d.id_cargo_cliente,",
                "    d.id_cliente,",
                "    d.rif,",
                "    d.razon_social,",
                "    d.id_contrato,",
                "    d.id_contrato_detalle,",
                "    d.numero_contrato,",
                "    d.fecha_cargo,",
                "    d.fecha_corte,",
                "    d.fecha_pago,",
                "    d.fecha_descuento,",
                "    d.tipo_cargo,",
                "    d.estado_pago,",
                "    d.servicio,",
                "    d.estatus_cliente,",
                "    d.id_franquicia,",
                "    d.nombre_franquicia,",
                "    d.zona,",
                "    d.cantidad_zonas,",
                "    d.id_moneda_cargo,",
                "    p.tasa_cargo::numeric(12,4) AS tasa_cargo,",
                "",
                "    -- CARGOS SIN REDONDEO PREMATURO",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_teorico_bs) ELSE 0 END AS monto_cargo_bs,",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_teorico_bs / nullif(p.tasa_cargo, 0)) ELSE 0 END AS monto_cargo_usd,",
                "",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_real_bs) ELSE 0 END AS monto_cargo_real_bs,",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_real_bs / nullif(p.tasa_cargo, 0)) ELSE 0 END AS monto_cargo_real_usd,",
                "",
                "    (d.monto_pago_bs) AS monto_pago_bs,",
                "    (d.monto_pago_usd) AS monto_pago_usd,",
                "    (d.monto_descuento_bs) AS monto_descuento_bs,",
                "    (d.monto_descuento_usd) AS monto_descuento_usd,",
                "",
                "    -- ECUACIÓN FORZADA (Cargos - Pagos - Descuentos) PARA QUE POWER BI CUADRE MATEMÁTICAMENTE",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN ((d.monto_cargo_teorico_bs / nullif(p.tasa_cargo, 0)) - d.monto_pago_usd - d.monto_descuento_usd)",
                "        ELSE 0",
                "    END AS saldo_pendiente_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN ((d.monto_cargo_real_bs / nullif(p.tasa_cargo, 0)) - d.monto_pago_usd - d.monto_descuento_usd)",
                "        ELSE 0",
                "    END AS saldo_pendiente_real_usd,",
                "",
                "    CASE WHEN d.tipo_cargo = 'RECUPERADO' AND d.estado_pago = 'PAGADO' THEN d.monto_pago_usd ELSE 0 END AS monto_recuperado_usd,",
                "    d.cantidad_facturas,",
                "    d.renglones_sin_tasa",
                "FROM detalle d",
                "CROSS JOIN parametros p;"
            },
            "#(lf)"
        ),
    Origen = Odbc.Query("dsn=PostgreSQL64CE", ConsultaSQL),
    #"Columnas con nombre cambiado" = Table.RenameColumns(Origen,{{"monto_descuento_usd", "descuento_usd"}})
in
    #"Columnas con nombre cambiado"
</file>

<file path="Querys/INGRESOS_CONSOLIDADO">
CREATE OR REPLACE VIEW powerbi.ingreso_consolidado
 AS
 WITH unificado AS (
         SELECT dc.fecha::date AS fecha,
            dc.zona,
            dc.franquicia,
            dc.moneda_base,
            dc.moneda_secundaria,
            dc.forma_pago,
            sum(dc.monto_base) AS monto_base,
            sum(dc.monto_secundario) AS monto_secundario
           FROM ingreso_dcaja dc
          WHERE dc.fecha::date >= '2026-01-01'::date AND dc.fecha::date <= '2026-12-31'::date
          GROUP BY dc.fecha, dc.zona, dc.franquicia, dc.moneda_base, dc.moneda_secundaria, dc.forma_pago
        UNION ALL
         SELECT dp.fecha::date AS fecha,
            dp.zona,
            dp.franquicia,
            dp.moneda_base,
            dp.moneda_secundaria,
            dp.forma_pago,
            sum(dp.monto_base) AS monto_base,
            sum(dp.monto_secundario) AS monto_secundario
           FROM ingreso_dpago dp
          WHERE dp.fecha::date >= '2026-01-01'::date AND dp.fecha::date <= '2026-12-31'::date
          GROUP BY dp.fecha, dp.zona, dp.franquicia, dp.moneda_base, dp.moneda_secundaria, dp.forma_pago
        )
 SELECT unp.fecha,
    unp.forma_pago,
    unp.moneda_base,
    sum(unp.monto_base) AS monto_base,
    unp.moneda_secundaria,
    sum(unp.monto_secundario) AS monto_secundario,
    (( SELECT max(tasa_moneda_read.tasa) AS max
           FROM administrativo.tasa_moneda_read(63, 51, unp.fecha) tasa_moneda_read(id_d_tasa_moneda, id_moneda, tasa, fecha_tasa, fecha_eliminacion, id_moneda_base)))::numeric AS tasa,
    round(sum(unp.monto_base) / (( SELECT max(tasa_moneda_read.tasa) AS max
           FROM administrativo.tasa_moneda_read(63, 51, unp.fecha) tasa_moneda_read(id_d_tasa_moneda, id_moneda, tasa, fecha_tasa, fecha_eliminacion, id_moneda_base)))::numeric, 2) AS monto_dolares,
    unp.zona,
    unp.franquicia
   FROM unificado unp
  GROUP BY unp.fecha, unp.moneda_base, unp.moneda_secundaria, unp.forma_pago, unp.zona, unp.franquicia;

ALTER TABLE powerbi.ingreso_consolidado
    OWNER TO postgres;

GRANT ALL ON TABLE powerbi.ingreso_consolidado TO postgres;
GRANT SELECT ON TABLE powerbi.ingreso_consolidado TO powerbi;
</file>

<file path="Querys/PBi - Cobranza - 26-08-2026">
let
    ConsultaSQL =
        Text.Combine(
            {
                "WITH parametros AS (",
                "    SELECT",
                "        TIMESTAMP '2026-08-01 00:00:00' AS mes_desde,",
                "        TIMESTAMP '2026-09-01 00:00:00' AS mes_hasta,",
                "        TIMESTAMP '2026-08-01 01:01:00' AS fin_carga_masiva,",
                "        DATE '2026-08-01' AS fecha_tarifa,",
                "        748.7864::numeric(12,4) AS tasa_cargo",
                "),",
                "",
                "movimientos_julio_ids AS MATERIALIZED (",
                "    SELECT DISTINCT",
                "        rf.id_cargo_cliente",
                "    FROM administrativo.d_renglon_factura rf",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "zonas_franquicia AS MATERIALIZED (",
                "    SELECT",
                "        fz.id_franquicia,",
                "        count(DISTINCT fz.id_zona)::integer AS cantidad_zonas,",
                "        string_agg(DISTINCT z.zona, ' | ' ORDER BY z.zona) AS zona",
                "    FROM operativo.m_franquicia_zona fz",
                "    JOIN ubigeo.m_zona z ON z.id_zona = fz.id_zona",
                "    WHERE fz.fecha_eliminacion IS NULL AND z.fecha_eliminacion IS NULL",
                "    GROUP BY fz.id_franquicia",
                "),",
                "",
                "cargos_clasificados AS MATERIALIZED (",
                "    SELECT",
                "        dcc.id_cargo_cliente,",
                "        dcc.id_cliente,",
                "        dcc.id_contrato_detalle,",
                "        cd.id_contrato,",
                "        dcc.id_paquete,",
                "        dcc.id_estatus,",
                "        dcc.fecha_creacion AS fecha_cargo,",
                "        dcc.fecha_registro,",
                "        coalesce(dcc.cantidad_puntos, 1) AS cantidad_puntos,", // Recupera los puntos extra del Excel
                "        cd.fecha_corte,",
                "        cd.id_franquicia,",
                "        cd.id_sector,",
                "        ctr.numero_contrato,",
                "        cli.rif,",
                "        cli.razon_social,",
                "        srv.servicio,",
                "        est.estatus AS estatus_cliente,",
                "        fr.nombre_franquicia,",
                "        zf.zona,",
                "        coalesce(zf.cantidad_zonas, 0) AS cantidad_zonas,",
                "        CASE",
                "            WHEN dcc.fecha_creacion < p.mes_desde AND mj.id_cargo_cliente IS NOT NULL THEN 'RECUPERADO'",
                "            WHEN dcc.fecha_creacion >= p.mes_desde AND dcc.fecha_creacion < p.fin_carga_masiva THEN 'GENERADO'",
                "            WHEN dcc.fecha_creacion >= p.fin_carga_masiva AND dcc.fecha_creacion < p.mes_hasta THEN 'POSTERIOR'",
                "        END AS tipo_cargo,",
                "        CASE",
                "            WHEN dcc.id_estatus = 58 AND mj.id_cargo_cliente IS NOT NULL THEN 'PAGADO'",
                "            ELSE 'NO PAGADO'",
                "        END AS estado_pago",
                "    FROM administrativo.d_cargo_cliente dcc",
                "    JOIN operativo.m_contrato_detalle cd ON cd.id_contrato_detalle = dcc.id_contrato_detalle",
                "    LEFT JOIN operativo.m_contrato ctr ON ctr.id_contrato = cd.id_contrato",
                "    LEFT JOIN operativo.m_cliente cli ON cli.id_cliente = dcc.id_cliente",
                "    LEFT JOIN operativo.m_franquicia fr ON fr.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN zonas_franquicia zf ON zf.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN operativo.m_tipo_servicio ts ON ts.id_tipo_servicio = cd.id_tipo_servicio",
                "    LEFT JOIN operativo.m_servicio srv ON srv.id_servicio = ts.id_servicio",
                "    LEFT JOIN comun.m_estatus est ON est.id_estatus = cd.id_estatus",
                "    LEFT JOIN movimientos_julio_ids mj ON mj.id_cargo_cliente = dcc.id_cargo_cliente",
                "    CROSS JOIN parametros p",
                "    WHERE dcc.fecha_creacion >= TIMESTAMP '2026-01-01 00:00:00'",
                "      AND dcc.fecha_creacion < p.mes_hasta",
                "      AND dcc.id_tipo_renglon in (1,9)",
                "),",
                "",
                "cargos_scope AS MATERIALIZED (",
                "    SELECT cc.* FROM cargos_clasificados cc WHERE cc.tipo_cargo IS NOT NULL",
                "),",
                "",
                "renglones_julio AS MATERIALIZED (",
                "    SELECT",
                "        rf.id_renglon_factura,",
                "        rf.id_cargo_cliente,",
                "        rf.id_factura,",
                "        rf.id_tarifa_servicio,",
                "        rf.id_moneda,",
                "        rf.id_ajuste_estatico,",
                "        rf.total_bruto::numeric AS total_bruto,",
                "        mf.fecha_registro AS fecha_movimiento",
                "    FROM cargos_scope cs",
                "    JOIN administrativo.d_renglon_factura rf ON rf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN administrativo.m_factura mf ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde AND mf.fecha_registro < p.mes_hasta AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "tasas_tarifa AS MATERIALIZED (",
                "    SELECT DISTINCT",
                "        m.id_moneda_cobro,",
                "        (SELECT tm.tasa::numeric FROM administrativo.tasa_moneda_read(63, m.id_moneda_cobro, p.fecha_tarifa) tm LIMIT 1) AS tasa",
                "    FROM (SELECT DISTINCT id_moneda_cobro FROM operativo.m_tarifa_servicio WHERE id_moneda_cobro IS NOT NULL) m",
                "    CROSS JOIN parametros p",
                "),",
                "",
                "tarifas_catalogo AS MATERIALIZED (",
                "    SELECT",
                "        tas.id_tarifa_servicio,",
                "        tas.id_paquete,",
                "        tas.id_franquicia,",
                "        tas.id_sector,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro,",
                "        tas.fecha_vigencia,",
                "        tt.tasa",
                "    FROM operativo.m_tarifa_servicio tas",
                "    CROSS JOIN parametros p",
                "    LEFT JOIN tasas_tarifa tt ON tt.id_moneda_cobro = tas.id_moneda_cobro",
                "    WHERE tas.fecha_eliminacion IS NULL AND tas.activo = true",
                "),",
                "",
                "claves_tasa AS (",
                "    SELECT DISTINCT rj.id_moneda, rj.fecha_movimiento::date AS fecha_tasa",
                "    FROM renglones_julio rj WHERE rj.id_moneda IS NOT NULL",
                "),",
                "",
                "tasas_movimiento AS (",
                "    SELECT ct.id_moneda, ct.fecha_tasa, tx.tasa",
                "    FROM claves_tasa ct",
                "    LEFT JOIN LATERAL (",
                "        SELECT tm.tasa::numeric AS tasa FROM administrativo.tasa_moneda_read(ct.id_moneda, 51, ct.fecha_tasa) tm LIMIT 1",
                "    ) tx ON true",
                "),",
                "",
                "movimientos_por_cargo AS (",
                "    SELECT",
                "        rj.id_cargo_cliente,",
                "        max(rj.fecha_movimiento) FILTER (WHERE rj.id_ajuste_estatico IS NULL) AS fecha_pago,",
                "        max(rj.fecha_movimiento) FILTER (WHERE rj.id_ajuste_estatico > 0) AS fecha_descuento,",
                "        count(DISTINCT rj.id_factura)::integer AS cantidad_facturas,",
                "        coalesce(sum(rj.total_bruto) FILTER (WHERE rj.id_ajuste_estatico IS NULL), 0) AS monto_pago_bs,",
                "        coalesce(sum(rj.total_bruto / nullif(tm.tasa, 0)) FILTER (WHERE rj.id_ajuste_estatico IS NULL), 0) AS monto_pago_usd,",
                "        abs(coalesce(sum(rj.total_bruto) FILTER (WHERE rj.id_ajuste_estatico > 0), 0)) AS monto_descuento_bs,",
                "        abs(coalesce(sum(rj.total_bruto / nullif(tm.tasa, 0)) FILTER (WHERE rj.id_ajuste_estatico > 0), 0)) AS monto_descuento_usd,",
                "        count(*) FILTER (WHERE tm.tasa IS NULL)::integer AS renglones_sin_tasa",
                "    FROM renglones_julio rj",
                "    LEFT JOIN tasas_movimiento tm ON tm.id_moneda = rj.id_moneda AND tm.fecha_tasa = rj.fecha_movimiento::date",
                "    GROUP BY rj.id_cargo_cliente",
                "),",
                "",
                "-- BASE REAL (Tarifa unitaria facturada)",
                "tarifa_facturada AS MATERIALIZED (",
                "    SELECT DISTINCT ON (rj.id_cargo_cliente)",
                "        rj.id_cargo_cliente,",
                "        tas.id_moneda_cobro,",
                "        (tas.monto_cobro::numeric * coalesce(tt.tasa, 1)) AS monto_cobro_unitario_bs",
                "    FROM renglones_julio rj",
                "    JOIN operativo.m_tarifa_servicio tas ON tas.id_tarifa_servicio = rj.id_tarifa_servicio",
                "    LEFT JOIN tasas_tarifa tt ON tt.id_moneda_cobro = tas.id_moneda_cobro",
                "    WHERE rj.id_ajuste_estatico IS NULL AND rj.id_tarifa_servicio IS NOT NULL",
                "    ORDER BY rj.id_cargo_cliente, rj.fecha_movimiento DESC, rj.id_renglon_factura DESC",
                "),",
                "",
                "-- BASE TEÓRICA (Tarifa unitaria del catálogo)",
                "tarifa_configurada AS MATERIALIZED (",
                "    SELECT DISTINCT ON (cs.id_cargo_cliente)",
                "        cs.id_cargo_cliente,",
                "        tc.id_moneda_cobro,",
                "        (tc.monto_cobro::numeric * coalesce(tc.tasa, 1)) AS monto_cobro_unitario_bs",
                "    FROM cargos_scope cs",
                "    JOIN tarifas_catalogo tc",
                "      ON tc.id_paquete = cs.id_paquete",
                "     AND (",
                "            (tc.id_franquicia = cs.id_franquicia AND (cs.id_sector <> 11362 OR cs.id_sector IS NULL) AND (tc.id_sector IS NULL OR tc.id_sector <> 11362))",
                "            OR",
                "            (tc.id_franquicia = cs.id_franquicia AND tc.id_sector = cs.id_sector)",
                "         )",
                "     AND extract(month from cs.fecha_registro::date) = extract(month from tc.fecha_vigencia::date)",
                "     AND extract(year from cs.fecha_registro::date) = extract(year from tc.fecha_vigencia::date)",
                "    WHERE cs.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "    ORDER BY cs.id_cargo_cliente, tc.id_tarifa_servicio DESC",
                "),",
                "",
                "detalle AS (",
                "    SELECT",
                "        cs.*,",
                "        coalesce(tc.id_moneda_cobro, tf.id_moneda_cobro, 0)::integer AS id_moneda_cargo,",
                "        -- Multiplica la tarifa base por la cantidad_puntos para igualar el Excel",
                "        (coalesce(tc.monto_cobro_unitario_bs, tf.monto_cobro_unitario_bs, 0)::numeric * cs.cantidad_puntos) AS monto_cargo_teorico_bs,",
                "        (coalesce(tf.monto_cobro_unitario_bs, tc.monto_cobro_unitario_bs, 0)::numeric * cs.cantidad_puntos) AS monto_cargo_real_bs,",
                "        mp.fecha_pago,",
                "        mp.fecha_descuento,",
                "        coalesce(mp.cantidad_facturas, 0) AS cantidad_facturas,",
                "        coalesce(mp.monto_pago_bs, 0) AS monto_pago_bs,",
                "        coalesce(mp.monto_pago_usd, 0) AS monto_pago_usd,",
                "        coalesce(mp.monto_descuento_bs, 0) AS monto_descuento_bs,",
                "        coalesce(mp.monto_descuento_usd, 0) AS monto_descuento_usd,",
                "        coalesce(mp.renglones_sin_tasa, 0) AS renglones_sin_tasa",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN tarifa_configurada tc ON tc.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN movimientos_por_cargo mp ON mp.id_cargo_cliente = cs.id_cargo_cliente",
                ")",
                "",
                "SELECT",
                "    d.id_cargo_cliente,",
                "    d.id_cliente,",
                "    d.rif,",
                "    d.razon_social,",
                "    d.id_contrato,",
                "    d.id_contrato_detalle,",
                "    d.numero_contrato,",
                "    d.fecha_cargo,",
                "    d.fecha_corte,",
                "    d.fecha_pago,",
                "    d.fecha_descuento,",
                "    d.tipo_cargo,",
                "    d.estado_pago,",
                "    d.servicio,",
                "    d.estatus_cliente,",
                "    d.id_franquicia,",
                "    d.nombre_franquicia,",
                "    d.zona,",
                "    d.cantidad_zonas,",
                "    d.id_moneda_cargo,",
                "    p.tasa_cargo::numeric(12,4) AS tasa_cargo,",
                "",
                "    -- CARGOS SIN REDONDEO PREMATURO",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_teorico_bs) ELSE 0 END AS monto_cargo_bs,",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_teorico_bs / nullif(p.tasa_cargo, 0)) ELSE 0 END AS monto_cargo_usd,",
                "",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_real_bs) ELSE 0 END AS monto_cargo_real_bs,",
                "    CASE WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR') THEN (d.monto_cargo_real_bs / nullif(p.tasa_cargo, 0)) ELSE 0 END AS monto_cargo_real_usd,",
                "",
                "    (d.monto_pago_bs) AS monto_pago_bs,",
                "    (d.monto_pago_usd) AS monto_pago_usd,",
                "    (d.monto_descuento_bs) AS monto_descuento_bs,",
                "    (d.monto_descuento_usd) AS monto_descuento_usd,",
                "",
                "    -- ECUACIÓN FORZADA (Cargos - Pagos - Descuentos) PARA QUE POWER BI CUADRE MATEMÁTICAMENTE",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN ((d.monto_cargo_teorico_bs / nullif(p.tasa_cargo, 0)) - d.monto_pago_usd - d.monto_descuento_usd)",
                "        ELSE 0",
                "    END AS saldo_pendiente_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN ((d.monto_cargo_real_bs / nullif(p.tasa_cargo, 0)) - d.monto_pago_usd - d.monto_descuento_usd)",
                "        ELSE 0",
                "    END AS saldo_pendiente_real_usd,",
                "",
                "    CASE WHEN d.tipo_cargo = 'RECUPERADO' AND d.estado_pago = 'PAGADO' THEN d.monto_pago_usd ELSE 0 END AS monto_recuperado_usd,",
                "    d.cantidad_facturas,",
                "    d.renglones_sin_tasa",
                "FROM detalle d",
                "CROSS JOIN parametros p;"
            },
            "#(lf)"
        ),
    Origen = Odbc.Query("dsn=PostgreSQL64CE", ConsultaSQL),
    #"Columnas con nombre cambiado" = Table.RenameColumns(Origen,{{"monto_descuento_usd", "descuento_usd"}})
in
    #"Columnas con nombre cambiado"
</file>

<file path="scripts/backup.sh">
#!/bin/sh
set -eu

STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="${BACKUP_DIR:-./backups/${STAMP}}"
mkdir -p "$BACKUP_DIR"

POSTGRES_DB="${POSTGRES_DB:-portal_reportes}"
POSTGRES_USER="${POSTGRES_USER:-portal_reportes}"

echo "Creando respaldo PostgreSQL..."
docker compose exec -T postgres pg_dump \
  -U "$POSTGRES_USER" \
  -d "$POSTGRES_DB" \
  -Fc > "$BACKUP_DIR/postgres.dump"

echo "Creando respaldo PocketBase..."
docker compose exec -T pocketbase tar -czf - -C /pb pb_data \
  > "$BACKUP_DIR/pocketbase-pb_data.tar.gz"

echo "Respaldos guardados en: $BACKUP_DIR"
</file>

