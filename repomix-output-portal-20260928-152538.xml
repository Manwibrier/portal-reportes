/* =========================================================
   Exportacion PDF mediante impresion del navegador
   ========================================================= */

@media print {
  @page {
    size: landscape;
    margin: 8mm;
  }

  body {
    background: #ffffff !important;
  }

  .sidebar,
  .header,
  .main-layout__sidebar,
  .main-layout__header,
  .finanzas-no-print {
    display: none !important;
  }

  .main-layout,
  .main-layout__content,
  .module-page,
  .module-page__content,
  .finanzas-story-dashboard {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .portal-card,
  .finanzas-metric-card {
    box-shadow: none !important;
    break-inside: avoid;
  }

  .finanzas-print-section {
    break-inside: auto;
    margin-bottom: 8mm;
  }

  body[data-finanzas-print-scope="mes"]
    .finanzas-print-section:not(
      [data-finanzas-section="mes"]
    ) {
    display: none !important;
  }

  body[data-finanzas-print-scope="comparativa"]
    .finanzas-print-section:not(
      [data-finanzas-section="comparativa"]
    ) {
    display: none !important;
  }

  body[data-finanzas-print-scope="ano"]
    .finanzas-print-section:not(
      [data-finanzas-section="ano"]
    ) {
    display: none !important;
  }

  .finanzas-full-matrix {
    min-width: 0 !important;
    width: 100% !important;
  }

  .finanzas-full-matrix th,
  .finanzas-full-matrix td {
    padding: 2px 3px !important;
    font-size: 6.4pt !important;
  }

  .finanzas-year-table-card,
  .finanzas-recent-chart-card {
    break-before: auto;
  }

  .recharts-responsive-container {
    min-height: 250px;
  }
}

