@media print {

  @page {
    size: A4 landscape;
    margin: 7mm;
  }

  body[data-finanzas-print] {
    background: #ffffff !important;
  }

  body[data-finanzas-print] .no-print,
  body[data-finanzas-print] .sidebar,
  body[data-finanzas-print] .portal-sidebar,
  body[data-finanzas-print] .mobile-menu-button {
    display: none !important;
  }

  body[data-finanzas-print="month"]
    .finanzas-print-section:not(
      [data-print-section="month"]
    ) {
    display: none !important;
  }

  body[data-finanzas-print="comparison"]
    .finanzas-print-section:not(
      [data-print-section="comparison"]
    ) {
    display: none !important;
  }

  body[data-finanzas-print="year"]
    .finanzas-print-section:not(
      [data-print-section="year"]
    ) {
    display: none !important;
  }

  body[data-finanzas-print]
    .finanzas-story-dashboard {
    gap: 8mm;
  }

  body[data-finanzas-print]
    .portal-card,
  body[data-finanzas-print]
    .finanzas-metric-card {
    box-shadow: none !important;
    break-inside: avoid;
  }

  body[data-finanzas-print]
    .finanzas-current-month-grid,
  body[data-finanzas-print]
    .finanzas-comparison-grid {
    grid-template-columns:
      repeat(5, 1fr) !important;
  }

  body[data-finanzas-print]
    .finanzas-year-summary-row {
    grid-template-columns:
      1.1fr 0.9fr !important;
  }

  body[data-finanzas-print]
    .finanzas-year-capsules {
    grid-template-columns:
      repeat(2, 1fr) !important;
  }

  body[data-finanzas-print]
    .finanzas-matrix-wrap {
    overflow: visible !important;
    max-height: none !important;
  }

  body[data-finanzas-print]
    .finanzas-matrix {
    min-width: 0 !important;
    width: 100% !important;
    table-layout: fixed !important;
  }

  body[data-finanzas-print]
    .finanzas-matrix th,
  body[data-finanzas-print]
    .finanzas-matrix td {
    font-size: 6.5pt !important;
    padding: 2.6pt !important;
  }

  body[data-finanzas-print]
    .recharts-responsive-container {
    max-height: 270px !important;
  }

  body[data-finanzas-print]
    .finanzas-year-table-card {
    break-before: page;
  }

  body[data-finanzas-print]
    .finanzas-recent-card {
    break-before: page;
  }
}

