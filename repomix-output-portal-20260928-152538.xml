      ),
      ticketsEmitidosVsCerrados: buildTornadoData(
        filteredRows,
        'departamento_emite',
        DEFAULT_TOP_LIMIT,
      ),
      cargaPorUsuario: buildWorkloadData(filteredRows, DEFAULT_TOP_LIMIT),
