/* SIDEBAR_CANONICAL_FINAL_BEGIN */

/* ==========================================================
   SIDEBAR CANONICO - PORTAL REPORTES

   REGLA CRITICA:
   El sidebar debe permanecer fuera del flujo normal.

   Si cambia a relative:
     sidebar ocupa su propio ancho
     +
     layout__content conserva margin-left
     =
     doble espacio lateral.
   ========================================================== */

.sidebar {
  position: fixed !important;

  top: 0 !important;
  left: 0 !important;
  bottom: 0 !important;

  height: 100vh !important;
  max-height: 100vh !important;

  isolation: isolate !important;

  z-index: 1100 !important;
}

/* ==========================================================
   NORTICO

   Debe quedar:
   - encima del fondo azul
   - debajo del menu y las letras
   - sin bloquear clicks
   ========================================================== */

.sidebar__mascot-panel {
  position: absolute !important;

  left: 0 !important;
  right: 0 !important;
  bottom: 4px !important;

  z-index: 1 !important;

  width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  pointer-events: none !important;

  background: transparent !important;
  background-image: none !important;

  border: 0 !important;
  box-shadow: none !important;

  opacity: 1 !important;
}

/* Imagen del robot */
.sidebar__mascot-image,
.sidebar__mascot,
.portal-sidebar-nortico-image {
  position: relative !important;

  z-index: 1 !important;

  display: block !important;

  height: auto !important;

  margin-left: auto !important;
  margin-right: auto !important;

  pointer-events: none !important;
  user-select: none !important;

  opacity: 1 !important;

  background: transparent !important;

  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
}

/* ==========================================================
   MENU ENCIMA DE NORTICO
   ========================================================== */

.sidebar__nav,
.sidebar__navigation,
.sidebar__menu,
.sidebar__content {
  position: relative !important;
  z-index: 5 !important;
}

/* Grupos, enlaces e iconos por encima del robot */
.sidebar__group,
.sidebar__link,
.sidebar__sublink,
.sidebar__group-title,
.sidebar__group-label,
.sidebar__link-content,
.sidebar__subnav,
.sidebar__icon-wrap,
.sidebar a,
.sidebar button {
  position: relative !important;
  z-index: 6 !important;
}

/*
  Las letras e iconos permanecen siempre
  delante del robot.
*/
.sidebar a span,
.sidebar button span,
.sidebar span,
.sidebar svg,
.sidebar__label,
.sidebar__text,
.sidebar__title {
  position: relative !important;
  z-index: 6 !important;
}

/* ==========================================================
   RESPONSIVE

   En responsive se elimina Nortico.
   NO se toca la geometria original del drawer/sidebar.
   ========================================================== */

@media (max-width: 1024px) {

  .sidebar__mascot-panel,
  .sidebar__mascot-panel::before,
  .sidebar__mascot-panel::after,
  .sidebar__mascot-image,
  .sidebar__mascot,
  .portal-sidebar-nortico-image {
    display: none !important;
  }
}

/* SIDEBAR_CANONICAL_FINAL_END */
