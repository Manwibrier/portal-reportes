  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.035em;
  text-transform: uppercase;
  white-space: nowrap;
}

.cobranza-table td {
  color: var(--portal-text, #0f172a);
}

.cobranza-table tbody tr:hover {
  background: rgba(15, 23, 42, 0.025);
}

.cobranza-risk-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 58px;
  border-radius: 999px;
  background: rgba(0, 80, 164, 0.1);
  color: var(--norte-blue, #0050a4);
  font-size: 0.72rem;
  font-weight: 400;
  padding: 0.24rem 0.55rem;
}

.cobranza-risk-chip--medio {
  background: rgba(255, 91, 0, 0.12);
  color: #c2410c;
}

.cobranza-risk-chip--alto {
  background: rgba(220, 38, 38, 0.11);
  color: #b91c1c;
}

@media (max-width: 1180px) {
  .cobranza-franquicias-heading,
  .cobranza-filter-bar,
  .cobranza-filter-bar--compact,
  .cobranza-metric-grid,
  .cobranza-percent-grid,
  .cobranza-franquicias-tornado-grid {
    grid-template-columns: 1fr;
  }

  .cobranza-ticket-tornado {
