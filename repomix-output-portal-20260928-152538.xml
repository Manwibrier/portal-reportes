/* COBRANZA_FRANQUICIAS_POSTERIORES_BEGIN */
.frq-post-summary {
  overflow: hidden;
}

.frq-post-summary__groups {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.frq-post-group {
  position: relative;
  min-width: 0;
  padding: 18px;
  overflow: hidden;
  border: 1px solid rgba(0, 87, 184, 0.14);
  border-radius: 18px;
  background: linear-gradient(145deg, #ffffff 0%, #f6f9fd 100%);
  box-shadow: 0 10px 24px rgba(15, 61, 130, 0.06);
}

.frq-post-group::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: 5px;
  background: var(--norte-blue);
}

.frq-post-group h4 {
  margin: 0 0 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(0, 87, 184, 0.12);
  color: var(--norte-blue-deep);
  font-size: 0.94rem;
  font-weight: var(--font-weight-bold);
}

.frq-post-group__metrics {
  display: grid;
  gap: 12px;
}

.frq-post-metric {
  display: grid;
  gap: 5px;
}

.frq-post-metric + .frq-post-metric {
  padding-top: 12px;
  border-top: 1px dashed rgba(15, 61, 130, 0.13);
}

.frq-post-metric span {
  color: var(--text-secondary);
  font-size: 0.76rem;
  font-weight: var(--font-weight-semibold);
  line-height: 1.25;
}

.frq-post-metric strong {
  color: var(--norte-blue-deep);
  font-size: clamp(1.08rem, 1.45vw, 1.42rem);
  font-weight: var(--font-weight-bold);
  line-height: 1.12;
  overflow-wrap: anywhere;
}

.frq-post-group--paid::before {
  background: var(--norte-blue);
}

.frq-post-group--pending::before {
  background: var(--norte-orange);
}

.frq-post-group--pending {
  background: linear-gradient(145deg, #ffffff 0%, #fff8f1 100%);
}

.frq-post-group--recovered::before {
  background: var(--success-color);
}

.frq-post-group--recovered {
  background: linear-gradient(145deg, #ffffff 0%, #f1fbf7 100%);
}

.frq-post-reconciliation {
  display: grid;
  gap: 5px;
  margin-top: 14px;
  padding: 13px 16px;
  border: 1px solid rgba(0, 87, 184, 0.14);
  border-radius: 14px;
  background: #f7f9fc;
}

.frq-post-reconciliation span {
  color: var(--text-secondary);
  font-size: 0.76rem;
  font-weight: var(--font-weight-semibold);
}

.frq-post-reconciliation strong {
  color: var(--norte-blue-deep);
  font-size: 0.9rem;
  overflow-wrap: anywhere;
}

.frq-post-reconciliation--ok {
  border-color: rgba(25, 135, 84, 0.28);
  background: #f1fbf7;
}

.frq-post-reconciliation--warning {
  border-color: rgba(255, 122, 0, 0.32);
  background: #fff8f1;
}

@media (max-width: 1300px) {
  .frq-post-summary__groups {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {
  .frq-post-summary__groups {
    grid-template-columns: 1fr;
  }
