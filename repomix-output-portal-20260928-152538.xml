    SUM(n.total_instalaciones_pendientes)::int AS total_instalaciones_pendientes,
    SUM(n.total_reclamos_finalizados)::int AS total_reclamos_finalizados
  FROM normalizado n
  WHERE n.anio IS NOT NULL
