let
    ConsultaSQL =
        Text.Combine(
            {
                "WITH parametros AS (",
                "    SELECT",
                "        TIMESTAMP '2026-08-01 00:00:00' AS mes_desde,",
                "        TIMESTAMP '2026-09-01 00:00:00' AS mes_hasta,",
                "        TIMESTAMP '2026-08-01 01:01:00' AS fin_carga_masiva,",
                "        DATE '2026-08-01' AS fecha_tarifa,",
                "        748.7864::numeric(12,4) AS tasa_cargo",
                "),",
                "",
                "-- Cargos con movimientos válidos durante julio",
                "movimientos_julio_ids AS MATERIALIZED (",
                "    SELECT DISTINCT",
                "        rf.id_cargo_cliente",
                "    FROM administrativo.d_renglon_factura rf",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "-- Una fila por franquicia para evitar multiplicar cargos",
                "zonas_franquicia AS MATERIALIZED (",
                "    SELECT",
                "        fz.id_franquicia,",
                "        count(DISTINCT fz.id_zona)::integer AS cantidad_zonas,",
                "        string_agg(",
                "            DISTINCT z.zona,",
                "            ' | '",
                "            ORDER BY z.zona",
                "        ) AS zona",
                "    FROM operativo.m_franquicia_zona fz",
                "    JOIN ubigeo.m_zona z",
                "      ON z.id_zona = fz.id_zona",
                "    WHERE fz.fecha_eliminacion IS NULL",
                "      AND z.fecha_eliminacion IS NULL",
                "    GROUP BY",
                "        fz.id_franquicia",
                "),",
                "",
                "-- Clasificación principal: una fila por cargo",
                "cargos_clasificados AS MATERIALIZED (",
                "    SELECT",
                "        dcc.id_cargo_cliente,",
                "        dcc.id_cliente,",
                "        dcc.id_contrato_detalle,",
                "        cd.id_contrato,",
                "        dcc.id_paquete,",
                "        dcc.id_estatus,",
                "        dcc.fecha_creacion AS fecha_cargo,",
                "        cd.fecha_corte,",
                "        cd.id_franquicia,",
                "        cd.id_sector,",
                "        ctr.numero_contrato,",
                "        cli.rif,",
                "        cli.razon_social,",
                "        srv.servicio,",
                "        est.estatus AS estatus_cliente,",
                "        fr.nombre_franquicia,",
                "        zf.zona,",
                "        coalesce(zf.cantidad_zonas, 0) AS cantidad_zonas,",
                "",
                "        CASE",
                "            WHEN dcc.fecha_creacion < p.mes_desde",
                "             AND mj.id_cargo_cliente IS NOT NULL",
                "                THEN 'RECUPERADO'",
                "",
                "            WHEN dcc.fecha_creacion >= p.mes_desde",
                "             AND dcc.fecha_creacion < p.fin_carga_masiva",
                "                THEN 'GENERADO'",
                "",
                "            WHEN dcc.fecha_creacion >= p.fin_carga_masiva",
                "             AND dcc.fecha_creacion < p.mes_hasta",
                "                THEN 'POSTERIOR'",
                "        END AS tipo_cargo,",
                "",
                "        CASE",
                "            WHEN dcc.id_estatus = 58",
                "             AND mj.id_cargo_cliente IS NOT NULL",
                "                THEN 'PAGADO'",
                "            ELSE 'NO PAGADO'",
                "        END AS estado_pago",
                "",
                "    FROM administrativo.d_cargo_cliente dcc",
                "    JOIN operativo.m_contrato_detalle cd",
                "      ON cd.id_contrato_detalle = dcc.id_contrato_detalle",
                "    LEFT JOIN operativo.m_contrato ctr",
                "      ON ctr.id_contrato = cd.id_contrato",
                "    LEFT JOIN operativo.m_cliente cli",
                "      ON cli.id_cliente = dcc.id_cliente",
                "    LEFT JOIN operativo.m_franquicia fr",
                "      ON fr.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN zonas_franquicia zf",
                "      ON zf.id_franquicia = cd.id_franquicia",
                "    LEFT JOIN operativo.m_tipo_servicio ts",
                "      ON ts.id_tipo_servicio = cd.id_tipo_servicio",
                "    LEFT JOIN operativo.m_servicio srv",
                "      ON srv.id_servicio = ts.id_servicio",
                "    LEFT JOIN comun.m_estatus est",
                "      ON est.id_estatus = cd.id_estatus",
                "    LEFT JOIN movimientos_julio_ids mj",
                "      ON mj.id_cargo_cliente = dcc.id_cargo_cliente",
                "    CROSS JOIN parametros p",
                "    WHERE dcc.fecha_creacion >= TIMESTAMP '2026-01-01 00:00:00'",
                "      AND dcc.fecha_creacion < p.mes_hasta",
                "      AND dcc.id_tipo_renglon in (1,9) ",
                "),",
                "",
                "cargos_scope AS MATERIALIZED (",
                "    SELECT",
                "        cc.*",
                "    FROM cargos_clasificados cc",
                "    WHERE cc.tipo_cargo IS NOT NULL",
                "),",
                "",
                "-- Renglones vinculados a movimientos de julio",
                "renglones_julio AS MATERIALIZED (",
                "    SELECT",
                "        rf.id_renglon_factura,",
                "        rf.id_cargo_cliente,",
                "        rf.id_factura,",
                "        rf.id_tarifa_servicio,",
                "        rf.id_moneda,",
                "        rf.id_ajuste_estatico,",
                "        rf.total_bruto::numeric AS total_bruto,",
                "        mf.fecha_registro AS fecha_movimiento",
                "    FROM cargos_scope cs",
                "    JOIN administrativo.d_renglon_factura rf",
                "      ON rf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN administrativo.m_factura mf",
                "      ON mf.id_factura = rf.id_factura",
                "    CROSS JOIN parametros p",
                "    WHERE mf.fecha_registro >= p.mes_desde",
                "      AND mf.fecha_registro < p.mes_hasta",
                "      AND mf.id_estatus IN (50, 51, 90)",
                "),",
                "",
                "-- Prioriza la tarifa realmente utilizada en la factura",
                "tarifa_facturada AS MATERIALIZED (",
                "    SELECT DISTINCT ON (rj.id_cargo_cliente)",
                "        rj.id_cargo_cliente,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro::numeric AS monto_cobro",
                "    FROM renglones_julio rj",
                "    JOIN operativo.m_tarifa_servicio tas",
                "      ON tas.id_tarifa_servicio = rj.id_tarifa_servicio",
                "    WHERE rj.id_ajuste_estatico IS NULL",
                "      AND rj.id_tarifa_servicio IS NOT NULL",
                "    ORDER BY",
                "        rj.id_cargo_cliente,",
                "        rj.fecha_movimiento DESC,",
                "        rj.id_renglon_factura DESC",
                "),",
                "",
                "tarifas_julio AS MATERIALIZED (",
                "    SELECT",
                "        tas.id_tarifa_servicio,",
                "        tas.id_paquete,",
                "        tas.id_franquicia,",
                "        tas.id_sector,",
                "        tas.id_moneda_cobro,",
                "        tas.monto_cobro::numeric AS monto_cobro",
                "    FROM operativo.m_tarifa_servicio tas",
                "    CROSS JOIN parametros p",
                "    WHERE tas.fecha_vigencia = p.fecha_tarifa",
                "      AND tas.activo = true",
                "      AND tas.fecha_eliminacion IS NULL",
                "),",
                "",
                "-- Tarifa configurada para cargos sin factura",
                "tarifa_configurada AS (",
                "    SELECT DISTINCT ON (cs.id_cargo_cliente)",
                "        cs.id_cargo_cliente,",
                "        tj.id_moneda_cobro,",
                "        tj.monto_cobro",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf",
                "      ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    JOIN tarifas_julio tj",
                "      ON tj.id_paquete = cs.id_paquete",
                "     AND tj.id_franquicia = cs.id_franquicia",
                "     AND (",
                "            tj.id_sector = cs.id_sector",
                "            OR (",
                "                cs.id_sector IS DISTINCT FROM 11362",
                "                AND tj.id_sector IS DISTINCT FROM 11362",
                "            )",
                "         )",
                "    WHERE tf.id_cargo_cliente IS NULL",
                "      AND cs.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "    ORDER BY",
                "        cs.id_cargo_cliente,",
                "        CASE",
                "            WHEN tj.id_sector IS NOT DISTINCT FROM cs.id_sector",
                "                THEN 1",
                "            WHEN tj.id_sector IS NULL",
                "                THEN 2",
                "            ELSE 3",
                "        END,",
                "        tj.id_tarifa_servicio DESC",
                "),",
                "",
                "claves_tasa AS (",
                "    SELECT DISTINCT",
                "        rj.id_moneda,",
                "        rj.fecha_movimiento::date AS fecha_tasa",
                "    FROM renglones_julio rj",
                "    WHERE rj.id_moneda IS NOT NULL",
                "),",
                "",
                "-- Una llamada a la función por moneda y fecha",
                "tasas_movimiento AS (",
                "    SELECT",
                "        ct.id_moneda,",
                "        ct.fecha_tasa,",
                "        tx.tasa",
                "    FROM claves_tasa ct",
                "    LEFT JOIN LATERAL (",
                "        SELECT",
                "            tm.tasa::numeric AS tasa",
                "        FROM administrativo.tasa_moneda_read(",
                "            ct.id_moneda,",
                "            51,",
                "            ct.fecha_tasa",
                "        ) tm(",
                "            id_d_tasa_moneda,",
                "            id_moneda,",
                "            tasa,",
                "            fecha_tasa,",
                "            fecha_eliminacion,",
                "            id_moneda_base",
                "        )",
                "        LIMIT 1",
                "    ) tx",
                "      ON true",
                "),",
                "",
                "movimientos_por_cargo AS (",
                "    SELECT",
                "        rj.id_cargo_cliente,",
                "",
                "        max(rj.fecha_movimiento) FILTER (",
                "            WHERE rj.id_ajuste_estatico IS NULL",
                "        ) AS fecha_pago,",
                "",
                "        max(rj.fecha_movimiento) FILTER (",
                "            WHERE rj.id_ajuste_estatico > 0",
                "        ) AS fecha_descuento,",
                "",
                "        count(DISTINCT rj.id_factura)::integer",
                "            AS cantidad_facturas,",
                "",
                "        coalesce(",
                "            sum(rj.total_bruto) FILTER (",
                "                WHERE rj.id_ajuste_estatico IS NULL",
                "            ),",
                "            0",
                "        ) AS monto_pago_bs,",
                "",
                "        coalesce(",
                "            sum(",
                "                rj.total_bruto / nullif(tm.tasa, 0)",
                "            ) FILTER (",
                "                WHERE rj.id_ajuste_estatico IS NULL",
                "            ),",
                "            0",
                "        ) AS monto_pago_usd,",
                "",
                "        abs(",
                "            coalesce(",
                "                sum(rj.total_bruto) FILTER (",
                "                    WHERE rj.id_ajuste_estatico > 0",
                "                ),",
                "                0",
                "            )",
                "        ) AS monto_descuento_bs,",
                "",
                "        abs(",
                "            coalesce(",
                "                sum(",
                "                    rj.total_bruto / nullif(tm.tasa, 0)",
                "                ) FILTER (",
                "                    WHERE rj.id_ajuste_estatico > 0",
                "                ),",
                "                0",
                "            )",
                "        ) AS monto_descuento_usd,",
                "",
                "        count(*) FILTER (",
                "            WHERE tm.tasa IS NULL",
                "        )::integer AS renglones_sin_tasa",
                "",
                "    FROM renglones_julio rj",
                "    LEFT JOIN tasas_movimiento tm",
                "      ON tm.id_moneda = rj.id_moneda",
                "     AND tm.fecha_tasa = rj.fecha_movimiento::date",
                "    GROUP BY",
                "        rj.id_cargo_cliente",
                "),",
                "",
                "detalle AS (",
                "    SELECT",
                "        cs.*,",
                "        coalesce(",
                "            tf.id_moneda_cobro,",
                "            tc.id_moneda_cobro,",
                "            0",
                "        )::integer AS id_moneda_cargo,",
                "",
                "        coalesce(",
                "            tf.monto_cobro,",
                "            tc.monto_cobro,",
                "            0",
                "        )::numeric AS monto_cargo_bs,",
                "",
                "        mp.fecha_pago,",
                "        mp.fecha_descuento,",
                "        coalesce(mp.cantidad_facturas, 0) AS cantidad_facturas,",
                "        coalesce(mp.monto_pago_bs, 0) AS monto_pago_bs,",
                "        coalesce(mp.monto_pago_usd, 0) AS monto_pago_usd,",
                "        coalesce(mp.monto_descuento_bs, 0) AS monto_descuento_bs,",
                "        coalesce(mp.monto_descuento_usd, 0) AS monto_descuento_usd,",
                "        coalesce(mp.renglones_sin_tasa, 0) AS renglones_sin_tasa",
                "",
                "    FROM cargos_scope cs",
                "    LEFT JOIN tarifa_facturada tf",
                "      ON tf.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN tarifa_configurada tc",
                "      ON tc.id_cargo_cliente = cs.id_cargo_cliente",
                "    LEFT JOIN movimientos_por_cargo mp",
                "      ON mp.id_cargo_cliente = cs.id_cargo_cliente",
                ")",
                "",
                "SELECT",
                "    d.id_cargo_cliente,",
                "    d.id_cliente,",
                "    d.rif,",
                "    d.razon_social,",
                "    d.id_contrato,",
                "    d.id_contrato_detalle,",
                "    d.numero_contrato,",
                "    d.fecha_cargo,",
                "    d.fecha_corte,",
                "    d.fecha_pago,",
                "    d.fecha_descuento,",
                "    d.tipo_cargo,",
                "    d.estado_pago,",
                "    d.servicio,",
                "    d.estatus_cliente,",
                "    d.id_franquicia,",
                "    d.nombre_franquicia,",
                "    d.zona,",
                "    d.cantidad_zonas,",
                "    d.id_moneda_cargo,",
                "",
                "    p.tasa_cargo::numeric(12,4) AS tasa_cargo,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN round(d.monto_cargo_bs, 2)",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_cargo_bs,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN round(",
                "                d.monto_cargo_bs / nullif(p.tasa_cargo, 0),",
                "                2",
                "            )",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_cargo_usd,",
                "",
                "    round(d.monto_pago_bs, 2)::numeric(18,2)",
                "        AS monto_pago_bs,",
                "",
                "    round(d.monto_pago_usd, 2)::numeric(18,2)",
                "        AS monto_pago_usd,",
                "",
                "    round(d.monto_descuento_bs, 2)::numeric(18,2)",
                "        AS monto_descuento_bs,",
                "",
                "    round(d.monto_descuento_usd, 2)::numeric(18,2)",
                "        AS monto_descuento_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo IN ('GENERADO', 'POSTERIOR')",
                "            THEN greatest(",
                "                round(",
                "                    d.monto_cargo_bs / nullif(p.tasa_cargo, 0),",
                "                    2",
                "                )",
                "                - round(d.monto_pago_usd, 2)",
                "                - round(d.monto_descuento_usd, 2),",
                "                0",
                "            )",
                "        ELSE 0",
                "    END::numeric(18,2) AS saldo_pendiente_usd,",
                "",
                "    CASE",
                "        WHEN d.tipo_cargo = 'RECUPERADO'",
                "         AND d.estado_pago = 'PAGADO'",
                "            THEN round(d.monto_pago_usd, 2)",
                "        ELSE 0",
                "    END::numeric(18,2) AS monto_recuperado_usd,",
                "",
                "    d.cantidad_facturas,",
                "    d.renglones_sin_tasa",
                "",
                "FROM detalle d",
                "CROSS JOIN parametros p;"
            },
            "#(lf)"
        ),
    Origen =
        Odbc.Query(
            "dsn=PostgreSQL64CE",
            ConsultaSQL
        ),
    #"Columnas con nombre cambiado" =
        Table.RenameColumns(
            Origen,
            {
                {"monto_descuento_usd", "descuento_usd"}
            }
        )
in
    #"Columnas con nombre cambiado"