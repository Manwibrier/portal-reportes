PORT=3000
NODE_ENV=production
FRONTEND_ORIGIN=http://__PORTAL_HOST__:8080

# Corporate PostgreSQL - read only report source.
DB_HOST=__POSTGRES_HOST__
DB_PORT=5432
DB_NAME=__POSTGRES_DATABASE__
DB_USER=__POSTGRES_READONLY_USER__
DB_PASSWORD=__POSTGRES_PASSWORD__
DB_SSL=true
DB_READ_ONLY=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=120000
DB_QUERY_TIMEOUT_MS=120000
DB_APP_NAME=portal-reportes-backend
DEFAULT_WINDOW_MONTHS=12

# Local authentication database.
AUTH_DB_PATH=./data/auth.sqlite
AUTH_SESSION_TTL_HOURS=12

SMARTOLT_BASE_URL=https://__SMARTOLT_HOST__/
SMARTOLT_STATUS_PATH=api/onu/get_onus_statuses
SMARTOLT_DETAILS_PATH=
SMARTOLT_SIGNALS_PATH=api/onu/get_onus_signals
SMARTOLT_OLTS_PATH=
SMARTOLT_API_TOKEN=__SMARTOLT_API_TOKEN__
SMARTOLT_AUTH_HEADER=X-Token
SMARTOLT_AUTH_SCHEME=
SMARTOLT_TIMEOUT_MS=90000

OPERACIONES_ORDENES_SCHEMA=powerbi
OPERACIONES_ORDENES_TABLE=ordenes_servicio
