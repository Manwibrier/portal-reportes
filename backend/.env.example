# Aplicación
PORT=3000
NODE_ENV=production
FRONTEND_ORIGIN=http://SERVER_IP

# PostgreSQL
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=120000
DB_QUERY_TIMEOUT_MS=120000
DB_APP_NAME=portal-reportes-backend

# Reportes
DEFAULT_WINDOW_MONTHS=12

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=CHANGE_ME
POCKETBASE_ADMIN_PASSWORD=CHANGE_ME
POCKETBASE_USERS_COLLECTION=users
POCKETBASE_SESSION_AUDITS_COLLECTION=session_audits

# SmartOLT
SMARTOLT_BASE_URL=https://cablenorte.smartolt.com/
SMARTOLT_STATUS_PATH=api/onu/get_onus_statuses
SMARTOLT_DETAILS_PATH=
SMARTOLT_SIGNALS_PATH=api/onu/get_onus_signals
SMARTOLT_OLTS_PATH=
SMARTOLT_API_TOKEN=CHANGE_ME
SMARTOLT_AUTH_HEADER=X-Token
SMARTOLT_AUTH_SCHEME=
SMARTOLT_TIMEOUT_MS=90000

# Operaciones
OPERACIONES_ORDENES_SCHEMA=powerbi
OPERACIONES_ORDENES_TABLE=ordenes_servicio